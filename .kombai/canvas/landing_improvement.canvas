        "y": 0,
        "w": 1440,
        "h": 5471
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    font-family: 'Outfit', sans-serif;\n    background-color: #FFFBFB;\n    color: #2D3748;\n    margin: 0;\n  }\n\n  .text-coral { color: #EB3D63; }\n  .bg-coral { background-color: #EB3D63; }\n  .border-coral { border-color: #EB3D63; }\n  \n  .blob-bg {\n    position: absolute;\n    z-index: -1;\n    filter: blur(40px);\n    opacity: 0.4;\n  }\n\n  .animate-float {\n    animation: float 6s ease-in-out infinite;\n  }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-20px); }\n  }\n\n  .video-mask {\n    mask-image: radial-gradient(circle, black 60%, transparent 100%);\n  }\n</style>\n\n<div class=\"relative overflow-hidden\" data-kid=\"1\">\n  \n  <nav class=\"absolute top-0 left-0 right-0 z-50 flex items-center justify-between px-8 py-6 max-w-7xl mx-auto\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-coral rounded-xl flex items-center justify-center shadow-lg shadow-coral/20\" data-kid=\"4\">\n        <i class=\"ti ti-heart-pulse text-white text-2xl\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"text-2xl font-bold tracking-tight text-slate-900\" data-kid=\"6\">MediClick</span>\n    </div>\n    \n    <div class=\"hidden md:flex items-center gap-8\" data-kid=\"7\">\n      <a href=\"#\" class=\"text-sm font-medium text-slate-600 hover:text-coral transition-colors\" data-kid=\"8\">Funciones</a>\n      <a href=\"#\" class=\"text-sm font-medium text-slate-600 hover:text-coral transition-colors\" data-kid=\"9\">Nosotros</a>\n      <a href=\"#\" class=\"text-sm font-medium text-slate-600 hover:text-coral transition-colors\" data-kid=\"10\">Blog</a>\n      <a href=\"#\" class=\"text-sm font-medium text-slate-600 hover:text-coral transition-colors\" data-kid=\"11\">Soporte</a>\n    </div>\n\n    <div class=\"flex items-center gap-4\" data-kid=\"12\">\n      <a href=\"#\" class=\"text-sm font-semibold text-slate-700 hover:text-coral\" data-kid=\"13\">Ingresa</a>\n      <a href=\"#\" class=\"bg-coral text-white px-6 py-2.5 rounded-full text-sm font-bold shadow-lg shadow-coral/20 hover:scale-105 transition-transform\" data-kid=\"14\">Regístrate</a>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative pt-32 pb-20 px-8\" data-kid=\"15\">\n    <div class=\"max-w-4xl mx-auto text-center relative z-10\" data-kid=\"16\">\n      <div class=\"inline-flex items-center gap-2 bg-coral/10 text-coral px-4 py-1.5 rounded-full text-xs font-bold mb-6 tracking-wide uppercase\" data-kid=\"17\">\n        <i class=\"ti ti-sparkles\" data-kid=\"18\"></i>\n        Impulsado por Inteligencia Artificial\n      </div>\n      <h1 class=\"text-6xl md:text-7xl font-extrabold text-slate-900 leading-[1.1] tracking-tight mb-8\" data-kid=\"19\">\n        Maneja tu atención médica con herramientas <span class=\"text-coral\" data-kid=\"20\">poderosas.</span>\n      </h1>\n      <p class=\"text-xl text-slate-600 max-w-2xl mx-auto mb-12 leading-relaxed\" data-kid=\"21\">\n        La plataforma diseñada por médicos para médicos. Optimiza tu tiempo, cuida a tus pacientes y olvida los papeles para siempre.\n      </p>\n      \n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4 mb-20\" data-kid=\"22\">\n        <button class=\"bg-coral text-white px-10 py-4 rounded-full text-lg font-bold shadow-xl shadow-coral/30 hover:shadow-2xl hover:scale-105 transition-all\" data-kid=\"23\">\n          Empieza ahora gratis\n        </button>\n        <button class=\"bg-white border-2 border-slate-200 text-slate-700 px-10 py-4 rounded-full text-lg font-bold hover:border-coral hover:text-coral transition-all\" data-kid=\"24\">\n          Ver demostración\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"relative max-w-6xl mx-auto\" data-kid=\"25\">\n      \n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/sbed/slow-blob.svg\" class=\"blob-bg top-0 -left-20 w-96 h-96\" style=\"color: #EB3D63;\" data-kid=\"26\">\n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/gooey-molecule.svg\" class=\"blob-bg -bottom-20 -right-20 w-[500px] h-[500px]\" style=\"color: #F0718D;\" data-kid=\"27\">\n      \n      <div class=\"relative rounded-[40px] overflow-hidden shadow-2xl border-8 border-white/50 backdrop-blur-sm\" data-kid=\"28\">\n        <video src=\"https://videos.pexels.com/video-files/6630467/6630467-uhd_4096_2160_25fps.mp4\" poster=\"https://images.pexels.com/videos/6630467/clinic-dental-doctor-health-care-6630467.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full aspect-video object-cover\" data-kid=\"29\"></video>\n        \n        \n        <div class=\"absolute top-10 right-10 w-64 bg-white/90 backdrop-blur-md p-4 rounded-2xl shadow-xl animate-float\" style=\"animation-delay: 1s;\" data-kid=\"30\">\n          <div class=\"flex items-center gap-3 mb-3\" data-kid=\"31\">\n            <div class=\"w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center\" data-kid=\"32\">\n              <i class=\"ti ti-calendar-check text-emerald-600 text-xl\" data-kid=\"33\"></i>\n            </div>\n            <div data-kid=\"34\">\n              <div class=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\" data-kid=\"35\">Nueva Cita</div>\n              <div class=\"text-sm font-bold text-slate-800\" data-kid=\"36\">Ana Banana</div>\n            </div>\n          </div>\n          <div class=\"text-[11px] text-slate-500 font-medium\" data-kid=\"37\">Lunes 15 de Agosto • 14:30</div>\n        </div>\n\n        <div class=\"absolute bottom-10 left-10 w-72 bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-xl animate-float\" data-kid=\"38\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"39\">\n            <div class=\"text-xs font-bold text-slate-800\" data-kid=\"40\">Diagnóstico CIE-10</div>\n            <i class=\"ti ti-search text-slate-400\" data-kid=\"41\"></i>\n          </div>\n          <div class=\"space-y-2\" data-kid=\"42\">\n            <div class=\"bg-coral/5 text-coral text-[10px] font-bold p-2 rounded-lg flex items-center justify-between\" data-kid=\"43\">\n              Diabetes Mellitus Tipo 2\n              <i class=\"ti ti-check\" data-kid=\"44\"></i>\n            </div>\n            <div class=\"bg-slate-50 text-slate-600 text-[10px] font-medium p-2 rounded-lg\" data-kid=\"45\">\n              Hipertensión Arterial\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-8 bg-white/50\" data-kid=\"46\">\n    <div class=\"max-w-7xl mx-auto space-y-40\" data-kid=\"47\">\n      \n      \n      <div class=\"flex flex-col md:flex-row items-center gap-20\" data-kid=\"48\">\n        <div class=\"flex-1 space-y-6\" data-kid=\"49\">\n          <div class=\"w-14 h-14 bg-coral/10 rounded-2xl flex items-center justify-center\" data-kid=\"50\">\n            <i class=\"ti ti-stethoscope text-coral text-3xl\" data-kid=\"51\"></i>\n          </div>\n          <h2 class=\"text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight\" data-kid=\"52\">\n            Diseñada por médicos para médicos.\n          </h2>\n          <p class=\"text-lg text-slate-600 leading-relaxed\" data-kid=\"53\">\n            Un sistema que piensa como tú. Menos tiempo navegando interfaces complejas y más tiempo concentrado en tus pacientes. Nuestra IA automatiza el registro para que nada se pierda.\n          </p>\n          <ul class=\"space-y-4\" data-kid=\"54\">\n            <li class=\"flex items-center gap-3 text-slate-700 font-medium\" data-kid=\"55\">\n              <i class=\"ti ti-circle-check-filled text-coral\" data-kid=\"56\"></i>\n              Historias clínicas inteligentes\n            </li>\n            <li class=\"flex items-center gap-3 text-slate-700 font-medium\" data-kid=\"57\">\n              <i class=\"ti ti-circle-check-filled text-coral\" data-kid=\"58\"></i>\n              Plantillas personalizables por especialidad\n            </li>\n          </ul>\n        </div>\n        <div class=\"flex-1 relative\" data-kid=\"59\">\n          <img src=\"https://images.unsplash.com/photo-1580616118171-77f0a6d1ab0d?auto=format&w=800&q=80&fit=crop\" alt=\"Clínica moderna\" class=\"rounded-[40px] shadow-2xl relative z-10\" decoding=\"async\" loading=\"lazy\" data-kid=\"60\">\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/sbed/slow-blob.svg\" class=\"absolute -top-10 -right-10 w-64 h-64 opacity-20\" style=\"color: #EB3D63;\" data-kid=\"61\">\n        </div>\n      </div>\n\n      \n      <div class=\"flex flex-col md:flex-row-reverse items-center gap-20\" data-kid=\"62\">\n        <div class=\"flex-1 space-y-6\" data-kid=\"63\">\n          <div class=\"w-14 h-14 bg-emerald-100 rounded-2xl flex items-center justify-center\" data-kid=\"64\">\n            <i class=\"ti ti-device-mobile text-emerald-600 text-3xl\" data-kid=\"65\"></i>\n          </div>\n          <h2 class=\"text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight\" data-kid=\"66\">\n            Tu consultorio siempre en tu bolsillo.\n          </h2>\n          <p class=\"text-lg text-slate-600 leading-relaxed\" data-kid=\"67\">\n            Accede a la información de tus pacientes desde cualquier lugar. Atiende teleconsultas, revisa historiales y firma recetas desde tu dispositivo móvil con total seguridad.\n          </p>\n          <div class=\"grid grid-cols-2 gap-6 pt-4\" data-kid=\"68\">\n            <div class=\"bg-white p-6 rounded-2xl shadow-sm border border-slate-100\" data-kid=\"69\">\n              <div class=\"text-2xl font-bold text-emerald-600 mb-1\" data-kid=\"70\">100%</div>\n              <div class=\"text-xs font-bold text-slate-500 uppercase tracking-wider\" data-kid=\"71\">Cifrado de datos</div>\n            </div>\n            <div class=\"bg-white p-6 rounded-2xl shadow-sm border border-slate-100\" data-kid=\"72\">\n              <div class=\"text-2xl font-bold text-emerald-600 mb-1\" data-kid=\"73\">24/7</div>\n              <div class=\"text-xs font-bold text-slate-500 uppercase tracking-wider\" data-kid=\"74\">Disponibilidad total</div>\n            </div>\n          </div>\n        </div>\n        <div class=\"flex-1 relative\" data-kid=\"75\">\n          <img src=\"https://images.unsplash.com/photo-1580615633791-571252a95de8?auto=format&w=800&q=80&fit=crop\" alt=\"Médico usando tablet\" class=\"rounded-[40px] shadow-2xl relative z-10\" decoding=\"async\" loading=\"lazy\" data-kid=\"76\">\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/gooey-molecule.svg\" class=\"absolute -bottom-10 -left-10 w-64 h-64 opacity-20\" style=\"color: #F0718D;\" data-kid=\"77\">\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-8 bg-coral/5\" data-kid=\"78\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"79\">\n      <div class=\"text-center mb-20\" data-kid=\"80\">\n        <h2 class=\"text-4xl md:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight\" data-kid=\"81\">\"Como magia.\"</h2>\n        <p class=\"text-xl text-slate-600\" data-kid=\"82\">Miles de doctores ya están transformando su práctica con MediClick.</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\" data-kid=\"83\">\n        \n        <div class=\"bg-white p-10 rounded-[32px] shadow-sm border border-slate-100 flex flex-col justify-between\" data-kid=\"84\">\n          <div data-kid=\"85\">\n            <div class=\"flex text-amber-400 gap-1 mb-6\" data-kid=\"86\">\n              <i class=\"ti ti-star-filled\" data-kid=\"87\"></i><i class=\"ti ti-star-filled\" data-kid=\"88\"></i><i class=\"ti ti-star-filled\" data-kid=\"89\"></i><i class=\"ti ti-star-filled\" data-kid=\"90\"></i><i class=\"ti ti-star-filled\" data-kid=\"91\"></i>\n            </div>\n            <p class=\"text-lg text-slate-700 font-medium leading-relaxed italic mb-10\" data-kid=\"92\">\n              \"MediClick es muy sencillo y fácil de usar. Ahora tenemos mucho más tiempo para nuestros pacientes.\"\n            </p>\n          </div>\n          <div class=\"flex items-center gap-4 pt-6 border-t border-slate-50\" data-kid=\"93\">\n            <img src=\"https://i.pravatar.cc/100?u=enrique\" class=\"w-14 h-14 rounded-full border-2 border-coral/20\" alt=\"Dr. Enrique Malpartida\" data-kid=\"94\">\n            <div data-kid=\"95\">\n              <div class=\"font-extrabold text-slate-900\" data-kid=\"96\">Dr. Enrique Malpartida</div>\n              <div class=\"text-xs font-bold text-coral uppercase tracking-wider\" data-kid=\"97\">Novapiel</div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bg-white rounded-[32px] shadow-sm border border-slate-100 overflow-hidden flex flex-col\" data-kid=\"98\">\n          <img src=\"https://images.unsplash.com/photo-1580615633623-4ec4d1aaf78d?auto=format&w=800&q=80&fit=crop\" class=\"h-48 w-full object-cover\" alt=\"Clínica San Felipe\" decoding=\"async\" loading=\"lazy\" data-kid=\"99\">\n          <div class=\"p-10 flex-1 flex flex-col justify-between\" data-kid=\"100\">\n            <p class=\"text-lg text-slate-700 font-medium leading-relaxed italic mb-8\" data-kid=\"101\">\n              \"Puedo atender a mis pacientes y mandarles sus recetas con pocos clicks. Todo lo manejo desde mi celular.\"\n            </p>\n            <div class=\"flex items-center gap-4\" data-kid=\"102\">\n              <img src=\"https://i.pravatar.cc/100?u=jorge\" class=\"w-12 h-12 rounded-full border-2 border-coral/20\" alt=\"Dr. Jorge Luis Espinoza\" data-kid=\"103\">\n              <div data-kid=\"104\">\n                <div class=\"font-extrabold text-slate-900 text-sm\" data-kid=\"105\">Dr. Jorge Luis Espinoza</div>\n                <div class=\"text-[10px] font-bold text-coral uppercase tracking-wider\" data-kid=\"106\">Clínica San Felipe</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bg-white p-10 rounded-[32px] shadow-sm border border-slate-100 flex flex-col justify-between\" data-kid=\"107\">\n          <div data-kid=\"108\">\n            <div class=\"flex text-amber-400 gap-1 mb-6\" data-kid=\"109\">\n              <i class=\"ti ti-star-filled\" data-kid=\"110\"></i><i class=\"ti ti-star-filled\" data-kid=\"111\"></i><i class=\"ti ti-star-filled\" data-kid=\"112\"></i><i class=\"ti ti-star-filled\" data-kid=\"113\"></i><i class=\"ti ti-star-filled\" data-kid=\"114\"></i>\n            </div>\n            <p class=\"text-lg text-slate-700 font-medium leading-relaxed italic mb-10\" data-kid=\"115\">\n              \"Me es mucho más fácil crear historias para pacientes nuevos. Sus recetas se ven muy profesionales.\"\n            </p>\n          </div>\n          <div class=\"flex items-center gap-4 pt-6 border-t border-slate-50\" data-kid=\"116\">\n            <img src=\"https://i.pravatar.cc/100?u=cristian\" class=\"w-14 h-14 rounded-full border-2 border-coral/20\" alt=\"Dr. Cristian Vásquez\" data-kid=\"117\">\n            <div data-kid=\"118\">\n              <div class=\"font-extrabold text-slate-900\" data-kid=\"119\">Dr. Cristian Vásquez</div>\n              <div class=\"text-xs font-bold text-coral uppercase tracking-wider\" data-kid=\"120\">Otosalud</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-8\" data-kid=\"121\">\n    <div class=\"max-w-6xl mx-auto bg-coral rounded-[60px] p-16 md:p-24 text-center relative overflow-hidden\" data-kid=\"122\">\n      \n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/sbed/slow-blob.svg\" class=\"absolute -top-40 -left-40 w-[600px] h-[600px] opacity-10\" style=\"color: white;\" data-kid=\"123\">\n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/gooey-molecule.svg\" class=\"absolute -bottom-40 -right-40 w-[600px] h-[600px] opacity-10\" style=\"color: white;\" data-kid=\"124\">\n      \n      <div class=\"relative z-10\" data-kid=\"125\">\n        <h2 class=\"text-5xl md:text-6xl font-extrabold text-white mb-8 tracking-tight leading-tight\" data-kid=\"126\">\n          ¿Listo para transformar <br class=\"hidden md:block\" data-kid=\"127\"> tu centro de salud?\n        </h2>\n        <p class=\"text-xl text-white/90 max-w-2xl mx-auto mb-12\" data-kid=\"128\">\n          Únete a la revolución de la salud digital. Comienza tu prueba gratuita hoy mismo, sin tarjetas de crédito.\n        </p>\n        <div class=\"flex flex-col sm:flex-row items-center justify-center gap-6\" data-kid=\"129\">\n          <button class=\"bg-white text-coral px-12 py-5 rounded-full text-xl font-bold shadow-2xl hover:scale-105 transition-all\" data-kid=\"130\">\n            Crear mi cuenta gratis\n          </button>\n          <button class=\"bg-transparent border-2 border-white/40 text-white px-12 py-5 rounded-full text-xl font-bold hover:bg-white/10 transition-all\" data-kid=\"131\">\n            Contactar ventas\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 px-8 bg-white border-t border-slate-100\" data-kid=\"132\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-5 gap-12\" data-kid=\"133\">\n      <div class=\"col-span-2 space-y-6\" data-kid=\"134\">\n        <div class=\"flex items-center gap-2\" data-kid=\"135\">\n          <div class=\"w-8 h-8 bg-coral rounded-lg flex items-center justify-center shadow-lg shadow-coral/20\" data-kid=\"136\">\n            <i class=\"ti ti-heart-pulse text-white text-lg\" data-kid=\"137\"></i>\n          </div>\n          <span class=\"text-xl font-bold tracking-tight text-slate-900\" data-kid=\"138\">MediClick</span>\n        </div>\n        <p class=\"text-slate-500 max-w-xs leading-relaxed\" data-kid=\"139\">\n          Potenciamos la atención médica con tecnología humana e inteligente. Hecho con amor para los médicos.\n        </p>\n        <div class=\"flex gap-4\" data-kid=\"140\">\n          <a href=\"#\" class=\"w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-coral hover:bg-coral/10 transition-all\" data-kid=\"141\">\n            <i class=\"ti ti-brand-twitter\" data-kid=\"142\"></i>\n          </a>\n          <a href=\"#\" class=\"w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-coral hover:bg-coral/10 transition-all\" data-kid=\"143\">\n            <i class=\"ti ti-brand-linkedin\" data-kid=\"144\"></i>\n          </a>\n          <a href=\"#\" class=\"w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-coral hover:bg-coral/10 transition-all\" data-kid=\"145\">\n            <i class=\"ti ti-brand-instagram\" data-kid=\"146\"></i>\n          </a>\n        </div>\n      </div>\n      \n      <div class=\"space-y-6\" data-kid=\"147\">\n        <h4 class=\"font-extrabold text-slate-900 text-sm uppercase tracking-widest\" data-kid=\"148\">Plataforma</h4>\n        <ul class=\"space-y-4 text-sm font-medium text-slate-500\" data-kid=\"149\">\n          <li data-kid=\"150\"><a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"151\">Funciones</a></li>\n          <li data-kid=\"152\"><a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"153\">Seguridad</a></li>\n          <li data-kid=\"154\"><a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"155\">App Móvil</a></li>\n        </ul>\n      </div>\n\n      <div class=\"space-y-6\" data-kid=\"156\">\n        <h4 class=\"font-extrabold text-slate-900 text-sm uppercase tracking-widest\" data-kid=\"157\">Empresa</h4>\n        <ul class=\"space-y-4 text-sm font-medium text-slate-500\" data-kid=\"158\">\n          <li data-kid=\"159\"><a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"160\">Nosotros</a></li>\n          <li data-kid=\"161\"><a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"162\">Blog</a></li>\n          <li data-kid=\"163\"><a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"164\">Carreras</a></li>\n        </ul>\n      </div>\n\n      <div class=\"space-y-6\" data-kid=\"165\">\n        <h4 class=\"font-extrabold text-slate-900 text-sm uppercase tracking-widest\" data-kid=\"166\">Soporte</h4>\n        <ul class=\"space-y-4 text-sm font-medium text-slate-500\" data-kid=\"167\">\n          <li data-kid=\"168\"><a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"169\">Ayuda</a></li>\n          <li data-kid=\"170\"><a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"171\">API Docs</a></li>\n          <li data-kid=\"172\"><a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"173\">Contacto</a></li>\n        </ul>\n      </div>\n    </div>\n    \n    <div class=\"max-w-7xl mx-auto pt-16 mt-16 border-t border-slate-50 flex flex-col md:flex-row justify-between items-center gap-6\" data-kid=\"174\">\n      <p class=\"text-xs font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"175\">© 2026 MediClick Inc. Reservados todos los derechos.</p>\n      <div class=\"flex gap-8 text-xs font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"176\">\n        <a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"177\">Privacidad</a>\n        <a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"178\">Términos</a>\n        <a href=\"#\" class=\"hover:text-coral transition-colors\" data-kid=\"179\">Cookies</a>\n      </div>\n    </div>\n  </footer>\n</div>",
      "comments": [],
      "created": "2026-07-08T05:10:09.567309+00:00",
      "modified": "2026-07-08T05:10:43.771884+00:00",
