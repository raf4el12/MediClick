      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css');\n\n  .font-serif { font-family: 'Lora', serif; }\n  .font-sans { font-family: 'Inter', sans-serif; }\n\n  .radial-gradient-hero {\n    background: radial-gradient(circle at center, rgba(14, 159, 159, 0.08) 0%, transparent 70%);\n  }\n\n  .bento-card {\n    background: white;\n    border-radius: 24px;\n    border: 1px solid rgba(0,0,0,0.04);\n    box-shadow: 0 10px 40px -10px rgba(0,0,0,0.04);\n    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  .bento-card:hover {\n    transform: translateY(-4px) perspective(1000px) rotateX(1deg);\n    box-shadow: 0 20px 60px -15px rgba(0,0,0,0.08);\n    border-color: rgba(14, 159, 159, 0.1);\n  }\n\n  .status-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n  }\n\n  .sparkline {\n    stroke-dasharray: 100;\n    stroke-dashoffset: 100;\n    animation: dash 2s linear forwards;\n  }\n\n  @keyframes dash {\n    to { stroke-dashoffset: 0; }\n  }\n\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 4px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: rgba(0,0,0,0.05);\n    border-radius: 10px;\n  }\n</style>\n\n<div class=\"font-sans text-[#111827] bg-[#FAFAFA] min-h-screen p-8\" data-kid=\"1\">\n  \n  <header class=\"flex items-center justify-between mb-12\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-[#0E9F9F] rounded-xl flex items-center justify-center shadow-lg shadow-teal-500/20\" data-kid=\"4\">\n        <i class=\"ri-heart-pulse-fill text-white text-xl\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"font-serif text-2xl font-bold tracking-tight\" data-kid=\"6\">MediClick</span>\n    </div>\n\n    <div class=\"flex items-center gap-6\" data-kid=\"7\">\n      <div class=\"relative hidden md:block\" data-kid=\"8\">\n        <i class=\"ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-gray-400\" data-kid=\"9\"></i>\n        <input type=\"text\" placeholder=\"Buscar paciente o historial...\" class=\"w-80 pl-11 pr-4 py-2.5 bg-white border border-black/5 rounded-full text-sm focus:outline-hidden focus:ring-2 focus:ring-[#0E9F9F]/20 transition-all\" data-kid=\"10\">\n      </div>\n      <div class=\"flex items-center gap-4\" data-kid=\"11\">\n        <button class=\"w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors relative\" data-kid=\"12\">\n          <i class=\"ri-notification-3-line text-xl text-gray-500\" data-kid=\"13\"></i>\n          <span class=\"absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white\" data-kid=\"14\"></span>\n        </button>\n        <div class=\"flex items-center gap-3 pl-4 border-l border-black/5\" data-kid=\"15\">\n          <div class=\"text-right\" data-kid=\"16\">\n            <p class=\"text-sm font-bold\" data-kid=\"17\">Dr. Arístides P.</p>\n            <p class=\"text-[10px] text-gray-400 font-bold uppercase tracking-wider\" data-kid=\"18\">Cardiólogo</p>\n          </div>\n          <img src=\"https://i.pravatar.cc/100?u=dr_ari\" alt=\"Doctor\" class=\"w-10 h-10 rounded-full border border-black/5\" data-kid=\"19\">\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"relative mb-12 text-center py-8 overflow-hidden rounded-[3rem]\" data-kid=\"20\">\n    <div class=\"absolute inset-0 radial-gradient-hero pointer-events-none\" data-kid=\"21\"></div>\n    <div class=\"relative z-10\" data-kid=\"22\">\n      <h1 class=\"font-serif text-5xl mb-4\" data-kid=\"23\">Buenos días, Dr. Arístides</h1>\n      <p class=\"text-gray-500 font-medium\" data-kid=\"24\">Hoy tienes un total de <span class=\"text-[#0E9F9F] font-bold\" data-kid=\"25\">12 pacientes</span> programados.</p>\n    </div>\n  </section>\n\n  \n  <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8\" data-kid=\"26\">\n    <div class=\"bento-card p-6 flex items-center gap-5\" data-kid=\"27\">\n      <div class=\"w-14 h-14 bg-teal-50 rounded-2xl flex items-center justify-center\" data-kid=\"28\">\n        <i class=\"ri-user-heart-line text-2xl text-[#0E9F9F]\" data-kid=\"29\"></i>\n      </div>\n      <div data-kid=\"30\">\n        <p class=\"text-2xl font-bold\" data-kid=\"31\">12</p>\n        <p class=\"text-sm text-gray-400 font-medium\" data-kid=\"32\">Pacientes para hoy</p>\n      </div>\n    </div>\n    <div class=\"bento-card p-6 flex items-center gap-5\" data-kid=\"33\">\n      <div class=\"w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center\" data-kid=\"34\">\n        <i class=\"ri-calendar-check-line text-2xl text-blue-500\" data-kid=\"35\"></i>\n      </div>\n      <div data-kid=\"36\">\n        <p class=\"text-2xl font-bold\" data-kid=\"37\">3</p>\n        <p class=\"text-sm text-gray-400 font-medium\" data-kid=\"38\">Citas pendientes</p>\n      </div>\n    </div>\n    <div class=\"bento-card p-6 flex items-center gap-5\" data-kid=\"39\">\n      <div class=\"w-14 h-14 bg-red-50 rounded-2xl flex items-center justify-center\" data-kid=\"40\">\n        <i class=\"ri-alarm-warning-line text-2xl text-red-500\" data-kid=\"41\"></i>\n      </div>\n      <div data-kid=\"42\">\n        <p class=\"text-2xl font-bold\" data-kid=\"43\">2</p>\n        <p class=\"text-sm text-gray-400 font-medium\" data-kid=\"44\">Urgencias reportadas</p>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"grid grid-cols-12 gap-8\" data-kid=\"45\">\n    \n    \n    <div class=\"col-span-12 lg:col-span-3\" data-kid=\"46\">\n      <div class=\"flex items-center justify-between mb-6 px-2\" data-kid=\"47\">\n        <h3 class=\"font-serif text-xl\" data-kid=\"48\">Agenda de Hoy</h3>\n        <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"49\">15 Abr</span>\n      </div>\n      <div class=\"space-y-4 max-h-[600px] overflow-y-auto pr-2 custom-scrollbar\" data-kid=\"50\">\n        \n        <div class=\"bento-card p-4 border-l-4 border-[#0E9F9F] bg-teal-50/30\" data-kid=\"51\">\n          <div class=\"flex justify-between items-start mb-3\" data-kid=\"52\">\n            <span class=\"text-[10px] font-bold text-[#0E9F9F] px-2 py-0.5 bg-teal-50 rounded-full\" data-kid=\"53\">EN CONSULTA</span>\n            <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"54\">09:30 AM</span>\n          </div>\n          <p class=\"font-bold text-sm mb-1\" data-kid=\"55\">Carlos Bravo Pérez</p>\n          <p class=\"text-[11px] text-gray-500\" data-kid=\"56\">Hipertensión arterial</p>\n        </div>\n        \n        <div class=\"bento-card p-4\" data-kid=\"57\">\n          <div class=\"flex justify-between items-start mb-3\" data-kid=\"58\">\n            <span class=\"text-[10px] font-bold text-blue-500 px-2 py-0.5 bg-blue-50 rounded-full\" data-kid=\"59\">PRÓXIMO</span>\n            <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"60\">10:15 AM</span>\n          </div>\n          <p class=\"font-bold text-sm mb-1\" data-kid=\"61\">Sofía Méndez</p>\n          <p class=\"text-[11px] text-gray-500\" data-kid=\"62\">Control Post-Operatorio</p>\n        </div>\n        \n        <div class=\"bento-card p-4 opacity-70\" data-kid=\"63\">\n          <div class=\"flex justify-between items-start mb-3\" data-kid=\"64\">\n            <span class=\"text-[10px] font-bold text-gray-400 px-2 py-0.5 bg-gray-50 rounded-full\" data-kid=\"65\">PENDIENTE</span>\n            <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"66\">11:00 AM</span>\n          </div>\n          <p class=\"font-bold text-sm mb-1\" data-kid=\"67\">Roberto Carle</p>\n          <p class=\"text-[11px] text-gray-500\" data-kid=\"68\">Consulta General</p>\n        </div>\n        <div class=\"bento-card p-4 opacity-70\" data-kid=\"69\">\n          <div class=\"flex justify-between items-start mb-3\" data-kid=\"70\">\n            <span class=\"text-[10px] font-bold text-gray-400 px-2 py-0.5 bg-gray-50 rounded-full\" data-kid=\"71\">PENDIENTE</span>\n            <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"72\">11:45 AM</span>\n          </div>\n          <p class=\"font-bold text-sm mb-1\" data-kid=\"73\">Ana Banana</p>\n          <p class=\"text-[11px] text-gray-500\" data-kid=\"74\">Revisión de Análisis</p>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"col-span-12 lg:col-span-6\" data-kid=\"75\">\n      <div class=\"bento-card h-full p-8\" data-kid=\"76\">\n        <div class=\"flex items-center justify-between mb-10\" data-kid=\"77\">\n          <div class=\"flex items-center gap-4\" data-kid=\"78\">\n            <div class=\"w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center font-bold text-lg text-gray-600\" data-kid=\"79\">CB</div>\n            <div data-kid=\"80\">\n              <h2 class=\"font-serif text-2xl\" data-kid=\"81\">Carlos Bravo Pérez</h2>\n              <p class=\"text-xs text-gray-400 font-medium\" data-kid=\"82\">Masculino, 45 años • ID: 70405632</p>\n            </div>\n          </div>\n          <div class=\"flex gap-2\" data-kid=\"83\">\n            <button class=\"p-2 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors text-gray-400\" data-kid=\"84\">\n              <i class=\"ri-history-line\" data-kid=\"85\"></i>\n            </button>\n            <button class=\"px-5 py-2 bg-[#0E9F9F] text-white text-xs font-bold rounded-xl shadow-lg shadow-teal-500/20\" data-kid=\"86\">Finalizar</button>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-6 mb-10\" data-kid=\"87\">\n          \n          <div class=\"p-5 bg-[#FAFAFA] rounded-[2rem] border border-black/5\" data-kid=\"88\">\n             <div class=\"flex items-center justify-between mb-4\" data-kid=\"89\">\n               <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"90\">Ritmo Cardíaco</span>\n               <i class=\"ri-heart-pulse-line text-[#0E9F9F]\" data-kid=\"91\"></i>\n             </div>\n             <div class=\"flex items-end justify-between\" data-kid=\"92\">\n               <span class=\"text-3xl font-bold tracking-tighter\" data-kid=\"93\">72 <span class=\"text-sm font-medium text-gray-400\" data-kid=\"94\">BPM</span></span>\n               <svg width=\"60\" height=\"20\" class=\"overflow-visible\" data-kid=\"95\">\n                 <path d=\"M0 10 L10 5 L20 15 L30 2 L40 18 L50 10 L60 12\" fill=\"none\" stroke=\"#0E9F9F\" stroke-width=\"2\" class=\"sparkline\" data-kid=\"96\"></path>\n               </svg>\n             </div>\n          </div>\n\n          <div class=\"p-5 bg-[#FAFAFA] rounded-[2rem] border border-black/5\" data-kid=\"97\">\n             <div class=\"flex items-center justify-between mb-4\" data-kid=\"98\">\n               <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"99\">Presión Art.</span>\n               <i class=\"ri-temp-hot-line text-blue-500\" data-kid=\"100\"></i>\n             </div>\n             <div class=\"flex items-end justify-between\" data-kid=\"101\">\n               <span class=\"text-3xl font-bold tracking-tighter\" data-kid=\"102\">120/80 <span class=\"text-sm font-medium text-gray-400\" data-kid=\"103\">mmHg</span></span>\n               <svg width=\"60\" height=\"20\" class=\"overflow-visible\" data-kid=\"104\">\n                 <path d=\"M0 15 L15 10 L30 18 L45 5 L60 10\" fill=\"none\" stroke=\"#3B82F6\" stroke-width=\"2\" class=\"sparkline\" data-kid=\"105\"></path>\n               </svg>\n             </div>\n          </div>\n\n          <div class=\"p-5 bg-[#FAFAFA] rounded-[2rem] border border-black/5\" data-kid=\"106\">\n             <div class=\"flex items-center justify-between mb-4\" data-kid=\"107\">\n               <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"108\">Temperatura</span>\n               <i class=\"ri-thermometer-line text-orange-500\" data-kid=\"109\"></i>\n             </div>\n             <div class=\"flex items-end justify-between\" data-kid=\"110\">\n               <span class=\"text-3xl font-bold tracking-tighter\" data-kid=\"111\">36.5 <span class=\"text-sm font-medium text-gray-400\" data-kid=\"112\">°C</span></span>\n             </div>\n          </div>\n\n          <div class=\"p-5 bg-[#FAFAFA] rounded-[2rem] border border-black/5\" data-kid=\"113\">\n             <div class=\"flex items-center justify-between mb-4\" data-kid=\"114\">\n               <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"115\">Saturación O2</span>\n               <i class=\"ri-windy-line text-green-500\" data-kid=\"116\"></i>\n             </div>\n             <div class=\"flex items-end justify-between\" data-kid=\"117\">\n               <span class=\"text-3xl font-bold tracking-tighter\" data-kid=\"118\">98 <span class=\"text-sm font-medium text-gray-400\" data-kid=\"119\">%</span></span>\n             </div>\n          </div>\n        </div>\n\n        <div class=\"space-y-6\" data-kid=\"120\">\n          <div class=\"flex items-center gap-2 mb-2\" data-kid=\"121\">\n            <h4 class=\"font-serif text-lg\" data-kid=\"122\">Notas Clínicas</h4>\n            <div class=\"flex-1 h-px bg-black/5\" data-kid=\"123\"></div>\n          </div>\n          <textarea placeholder=\"Escribe el diagnóstico y plan de tratamiento...\" class=\"w-full h-40 p-6 bg-[#FAFAFA] border border-black/5 rounded-3xl text-sm focus:outline-hidden focus:ring-2 focus:ring-[#0E9F9F]/20 transition-all resize-none\" data-kid=\"124\"></textarea>\n          <div class=\"flex gap-4\" data-kid=\"125\">\n            <button class=\"flex-1 py-3 bg-gray-100 text-gray-600 font-bold rounded-2xl text-xs hover:bg-gray-200 transition-colors\" data-kid=\"126\">\n              <i class=\"ri-mic-line mr-2\" data-kid=\"127\"></i> Dictar por Voz\n            </button>\n            <button class=\"flex-1 py-3 bg-black text-white font-bold rounded-2xl text-xs hover:bg-gray-800 transition-colors\" data-kid=\"128\">\n              <i class=\"ri-save-line mr-2\" data-kid=\"129\"></i> Guardar Borrador\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"col-span-12 lg:col-span-3 space-y-8\" data-kid=\"130\">\n      \n      <div data-kid=\"131\">\n        <h3 class=\"font-serif text-xl mb-6 px-2\" data-kid=\"132\">Acciones Rápidas</h3>\n        <div class=\"space-y-3\" data-kid=\"133\">\n          <button class=\"w-full bento-card p-5 flex items-center justify-between group\" data-kid=\"134\">\n            <div class=\"flex items-center gap-4\" data-kid=\"135\">\n              <div class=\"w-10 h-10 bg-teal-50 rounded-xl flex items-center justify-center text-[#0E9F9F]\" data-kid=\"136\">\n                <i class=\"ri-medicine-bottle-line text-xl\" data-kid=\"137\"></i>\n              </div>\n              <span class=\"text-sm font-bold text-gray-600\" data-kid=\"138\">Nueva Receta</span>\n            </div>\n            <i class=\"ri-arrow-right-s-line text-gray-300 group-hover:translate-x-1 transition-transform\" data-kid=\"139\"></i>\n          </button>\n          <button class=\"w-full bento-card p-5 flex items-center justify-between group\" data-kid=\"140\">\n            <div class=\"flex items-center gap-4\" data-kid=\"141\">\n              <div class=\"w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center text-blue-500\" data-kid=\"142\">\n                <i class=\"ri-flask-line text-xl\" data-kid=\"143\"></i>\n              </div>\n              <span class=\"text-sm font-bold text-gray-600\" data-kid=\"144\">Orden Laboratorio</span>\n            </div>\n            <i class=\"ri-arrow-right-s-line text-gray-300 group-hover:translate-x-1 transition-transform\" data-kid=\"145\"></i>\n          </button>\n          <button class=\"w-full bento-card p-5 flex items-center justify-between group\" data-kid=\"146\">\n            <div class=\"flex items-center gap-4\" data-kid=\"147\">\n              <div class=\"w-10 h-10 bg-purple-50 rounded-xl flex items-center justify-center text-purple-500\" data-kid=\"148\">\n                <i class=\"ri-file-search-line text-xl\" data-kid=\"149\"></i>\n              </div>\n              <span class=\"text-sm font-bold text-gray-600\" data-kid=\"150\">Interconsulta</span>\n            </div>\n            <i class=\"ri-arrow-right-s-line text-gray-300 group-hover:translate-x-1 transition-transform\" data-kid=\"151\"></i>\n          </button>\n        </div>\n      </div>\n\n      \n      <div data-kid=\"152\">\n        <h3 class=\"font-serif text-xl mb-6 px-2\" data-kid=\"153\">Resultados Recientes</h3>\n        <div class=\"bento-card p-6 overflow-hidden relative\" data-kid=\"154\">\n          <img src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&w=400&q=80&fit=crop\" class=\"absolute inset-0 w-full h-full object-cover opacity-5 pointer-events-none\" alt=\"Data overlay\" data-kid=\"155\">\n          <div class=\"relative z-10 space-y-6\" data-kid=\"156\">\n            <div class=\"flex items-center gap-4\" data-kid=\"157\">\n              <div class=\"w-2 h-10 bg-red-400 rounded-full\" data-kid=\"158\"></div>\n              <div data-kid=\"159\">\n                <p class=\"text-[10px] font-bold text-gray-400 uppercase\" data-kid=\"160\">Hemograma Completo</p>\n                <p class=\"text-sm font-bold\" data-kid=\"161\">Analítico disponible</p>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-4 opacity-50\" data-kid=\"162\">\n              <div class=\"w-2 h-10 bg-gray-200 rounded-full\" data-kid=\"163\"></div>\n              <div data-kid=\"164\">\n                <p class=\"text-[10px] font-bold text-gray-400 uppercase\" data-kid=\"165\">Perfil Lipídico</p>\n                <p class=\"text-sm font-bold\" data-kid=\"166\">En proceso...</p>\n              </div>\n            </div>\n            <button class=\"w-full py-2.5 mt-4 text-[10px] font-bold text-[#0E9F9F] uppercase tracking-widest border border-teal-100 rounded-xl hover:bg-teal-50 transition-colors\" data-kid=\"167\">Ver todos los reportes</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
