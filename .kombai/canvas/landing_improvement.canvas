        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-sans {\n    font-family: 'Inter', sans-serif;\n  }\n\n  .step-circle {\n    @apply w-8 h-8 rounded-full border-2 flex items-center justify-center text-sm font-bold transition-all duration-300;\n  }\n\n  .step-active .step-circle {\n    @apply border-blue-600 bg-blue-600 text-white;\n  }\n\n  .step-inactive .step-circle {\n    @apply border-slate-200 bg-white text-slate-400;\n  }\n\n  .step-completed .step-circle {\n    @apply border-blue-600 bg-white text-blue-600;\n  }\n\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 4px;\n    height: 4px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    @apply bg-slate-200 rounded-full;\n  }\n</style>\n\n<div class=\"font-sans text-slate-900 bg-white min-h-screen p-8 md:p-12\" data-kid=\"1\">\n  <div class=\"max-w-5xl mx-auto\" data-kid=\"2\">\n    \n    <div class=\"mb-10\" data-kid=\"3\">\n      <h1 class=\"text-3xl font-extrabold tracking-tight mb-2\" data-kid=\"4\">Agendar Cita Médica</h1>\n      <p class=\"text-slate-500\" data-kid=\"5\">Completa los pasos para reservar tu atención en MediClick.</p>\n    </div>\n\n    \n    <div class=\"grid grid-cols-1 md:grid-cols-[300px_1fr] border border-slate-200 rounded-xl overflow-hidden min-h-[600px]\" data-kid=\"6\">\n      \n      \n      <div class=\"bg-slate-50/50 p-8 border-r border-slate-200\" data-kid=\"7\">\n        <div class=\"space-y-8 relative\" data-kid=\"8\">\n          \n          <div class=\"absolute left-[15px] top-4 bottom-4 w-0.5 bg-slate-200 z-0\" data-kid=\"9\"></div>\n\n          \n          <div class=\"relative z-10 flex items-start gap-4 step-completed\" data-kid=\"10\">\n            <div class=\"step-circle\" data-kid=\"11\"><i class=\"ti ti-check text-xs\" data-kid=\"12\"></i></div>\n            <div data-kid=\"13\">\n              <p class=\"text-xs font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"14\">Paso 1</p>\n              <p class=\"text-sm font-semibold text-slate-900\" data-kid=\"15\">Sede</p>\n            </div>\n          </div>\n\n          \n          <div class=\"relative z-10 flex items-start gap-4 step-active\" data-kid=\"16\">\n            <div class=\"step-circle\" data-kid=\"17\">2</div>\n            <div data-kid=\"18\">\n              <p class=\"text-xs font-bold text-blue-600 uppercase tracking-widest\" data-kid=\"19\">Paso 2</p>\n              <p class=\"text-sm font-semibold text-slate-900\" data-kid=\"20\">Especialidad</p>\n            </div>\n          </div>\n\n          \n          <div class=\"relative z-10 flex items-start gap-4 step-inactive\" data-kid=\"21\">\n            <div class=\"step-circle\" data-kid=\"22\">3</div>\n            <div data-kid=\"23\">\n              <p class=\"text-xs font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"24\">Paso 3</p>\n              <p class=\"text-sm font-semibold text-slate-400\" data-kid=\"25\">Doctor</p>\n            </div>\n          </div>\n\n          \n          <div class=\"relative z-10 flex items-start gap-4 step-inactive\" data-kid=\"26\">\n            <div class=\"step-circle\" data-kid=\"27\">4</div>\n            <div data-kid=\"28\">\n              <p class=\"text-xs font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"29\">Paso 4</p>\n              <p class=\"text-sm font-semibold text-slate-400\" data-kid=\"30\">Fecha y Hora</p>\n            </div>\n          </div>\n\n          \n          <div class=\"relative z-10 flex items-start gap-4 step-inactive\" data-kid=\"31\">\n            <div class=\"step-circle\" data-kid=\"32\">5</div>\n            <div data-kid=\"33\">\n              <p class=\"text-xs font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"34\">Paso 5</p>\n              <p class=\"text-sm font-semibold text-slate-400\" data-kid=\"35\">Confirmar</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"mt-20 p-4 bg-blue-50 border border-blue-100 rounded-lg\" data-kid=\"36\">\n          <p class=\"text-xs font-bold text-blue-700 uppercase mb-2\" data-kid=\"37\">Resumen parcial</p>\n          <div class=\"flex items-center gap-2 text-slate-600 mb-1\" data-kid=\"38\">\n            <i class=\"ti ti-building-hospital text-sm\" data-kid=\"39\"></i>\n            <span class=\"text-xs font-medium\" data-kid=\"40\">Clínica San Borja</span>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"flex flex-col h-full bg-white\" data-kid=\"41\">\n        \n        <div class=\"p-8 flex-1\" data-kid=\"42\">\n          <div class=\"mb-8\" data-kid=\"43\">\n            <h2 class=\"text-xl font-bold mb-4\" data-kid=\"44\">¿En qué especialidad deseas atenderte?</h2>\n            <div class=\"relative max-w-md\" data-kid=\"45\">\n              <i class=\"ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-kid=\"46\"></i>\n              <input type=\"text\" placeholder=\"Buscar especialidad...\" class=\"w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 transition-all\" data-kid=\"47\">\n            </div>\n          </div>\n\n          <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\" data-kid=\"48\">\n            \n            <button class=\"flex items-center gap-4 p-4 border border-slate-200 rounded-xl hover:bg-slate-50 hover:border-blue-600 group transition-all text-left\" data-kid=\"49\">\n              <div class=\"w-12 h-12 rounded-lg bg-slate-50 flex items-center justify-center text-slate-600 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors\" data-kid=\"50\">\n                <i class=\"ti ti-heart-pulse text-2xl\" data-kid=\"51\"></i>\n              </div>\n              <div data-kid=\"52\">\n                <p class=\"text-sm font-bold text-slate-900\" data-kid=\"53\">Cardiología</p>\n                <p class=\"text-xs text-slate-500\" data-kid=\"54\">Salud del corazón y sistema circulatorio.</p>\n              </div>\n            </button>\n\n            <button class=\"flex items-center gap-4 p-4 border border-blue-600 bg-blue-50/30 rounded-xl group transition-all text-left\" data-kid=\"55\">\n              <div class=\"w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600 transition-colors\" data-kid=\"56\">\n                <i class=\"ti ti-stethoscope text-2xl\" data-kid=\"57\"></i>\n              </div>\n              <div data-kid=\"58\">\n                <p class=\"text-sm font-bold text-slate-900\" data-kid=\"59\">Medicina General</p>\n                <p class=\"text-xs text-slate-500\" data-kid=\"60\">Consulta primaria y chequeos preventivos.</p>\n              </div>\n            </button>\n\n            <button class=\"flex items-center gap-4 p-4 border border-slate-200 rounded-xl hover:bg-slate-50 hover:border-blue-600 group transition-all text-left\" data-kid=\"61\">\n              <div class=\"w-12 h-12 rounded-lg bg-slate-50 flex items-center justify-center text-slate-600 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors\" data-kid=\"62\">\n                <i class=\"ti ti-brain text-2xl\" data-kid=\"63\"></i>\n              </div>\n              <div data-kid=\"64\">\n                <p class=\"text-sm font-bold text-slate-900\" data-kid=\"65\">Neurología</p>\n                <p class=\"text-xs text-slate-500\" data-kid=\"66\">Trastornos del sistema nervioso.</p>\n              </div>\n            </button>\n\n            <button class=\"flex items-center gap-4 p-4 border border-slate-200 rounded-xl hover:bg-slate-50 hover:border-blue-600 group transition-all text-left\" data-kid=\"67\">\n              <div class=\"w-12 h-12 rounded-lg bg-slate-50 flex items-center justify-center text-slate-600 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors\" data-kid=\"68\">\n                <i class=\"ti ti-nurse text-2xl\" data-kid=\"69\"></i>\n              </div>\n              <div data-kid=\"70\">\n                <p class=\"text-sm font-bold text-slate-900\" data-kid=\"71\">Pediatría</p>\n                <p class=\"text-xs text-slate-500\" data-kid=\"72\">Atención médica para niños y bebés.</p>\n              </div>\n            </button>\n          </div>\n        </div>\n\n        \n        <div class=\"p-6 border-t border-slate-200 flex justify-between items-center bg-slate-50/30\" data-kid=\"73\">\n          <button class=\"flex items-center gap-2 px-6 py-2.5 text-sm font-bold text-slate-600 hover:text-slate-900 transition-colors\" data-kid=\"74\">\n            <i class=\"ti ti-arrow-left\" data-kid=\"75\"></i>\n            Atrás\n          </button>\n          <button class=\"flex items-center gap-2 px-8 py-2.5 bg-blue-600 text-white text-sm font-bold rounded-lg shadow-sm hover:bg-blue-700 transition-all\" data-kid=\"76\">\n            Siguiente\n            <i class=\"ti ti-arrow-right\" data-kid=\"77\"></i>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"mt-20 opacity-50 pointer-events-none grayscale\" data-kid=\"78\">\n       <div class=\"mb-4 flex items-center gap-2\" data-kid=\"79\">\n         <span class=\"px-2 py-1 bg-slate-100 text-[10px] font-bold rounded-sm border border-slate-200\" data-kid=\"80\">VISTA PREVIA PASO 2: DOCTORES</span>\n       </div>\n       <div class=\"border border-slate-200 rounded-xl p-6 bg-white space-y-4\" data-kid=\"81\">\n          <div class=\"flex items-center justify-between p-4 border border-slate-200 rounded-lg\" data-kid=\"82\">\n            <div class=\"flex items-center gap-4\" data-kid=\"83\">\n              <div class=\"w-12 h-12 rounded-full border border-slate-200 flex items-center justify-center font-bold bg-slate-50\" data-kid=\"84\">DG</div>\n              <div data-kid=\"85\">\n                <p class=\"text-sm font-bold\" data-kid=\"86\">Dr. Diego Gutiérrez</p>\n                <div class=\"flex gap-2 mt-1\" data-kid=\"87\">\n                  <span class=\"px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-bold rounded-full border border-blue-100\" data-kid=\"88\">TOP RATED</span>\n                  <span class=\"px-2 py-0.5 bg-emerald-50 text-emerald-600 text-[10px] font-bold rounded-full border border-emerald-100\" data-kid=\"89\">DISPONIBLE HOY</span>\n                </div>\n              </div>\n            </div>\n            <i class=\"ti ti-chevron-right text-slate-400\" data-kid=\"90\"></i>\n          </div>\n       </div>\n    </div>\n  </div>\n</div>",
