      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-serif { font-family: 'Playfair Display', serif; }\n  .font-sans { font-family: 'Plus Jakarta Sans', sans-serif; }\n\n  .sidebar-active {\n    background: rgba(59, 130, 246, 0.1);\n    border-right: 3px solid #3B82F6;\n    color: #3B82F6;\n  }\n\n  .ticket-stub {\n    position: relative;\n    overflow: hidden;\n  }\n  .ticket-stub::before, .ticket-stub::after {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    width: 16px;\n    height: 16px;\n    background: #F1F5F9;\n    border-radius: 50%;\n    transform: translateY(-50%);\n    z-index: 10;\n  }\n  .ticket-stub::before { left: -8px; }\n  .ticket-stub::after { right: -8px; }\n\n  .dashed-sep {\n    border-right: 1px dashed #E2E8F0;\n  }\n\n  .scalloped-icon {\n    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;\n  }\n\n  .glass-card {\n    background: rgba(15, 23, 42, 0.8);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  /* Custom Scrollbar */\n  .custom-scroll::-webkit-scrollbar {\n    height: 4px;\n    width: 4px;\n  }\n  .custom-scroll::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .custom-scroll::-webkit-scrollbar-thumb {\n    background: #CBD5E1;\n    border-radius: 10px;\n  }\n</style>\n\n<div class=\"flex min-h-screen bg-[#F1F5F9] font-sans text-slate-900\" data-kid=\"1\">\n  \n  <aside class=\"w-64 bg-[#0F172A] text-slate-400 flex flex-col fixed h-full z-30\" data-kid=\"2\">\n    <div class=\"p-6 flex items-center gap-3\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center text-white shadow-lg shadow-blue-500/20\" data-kid=\"4\">\n        <i class=\"ti ti-pulse text-2xl\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"text-xl font-bold text-white tracking-tight\" data-kid=\"6\">MediClick</span>\n    </div>\n\n    <nav class=\"flex-1 mt-4 px-4 space-y-2\" data-kid=\"7\">\n      <p class=\"px-2 text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-2\" data-kid=\"8\">Menú Principal</p>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl sidebar-active text-blue-500\" data-kid=\"9\">\n        <i class=\"ti ti-layout-dashboard text-lg\" data-kid=\"10\"></i>\n        <span class=\"font-semibold text-sm\" data-kid=\"11\">Tablero</span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all text-sm font-medium\" data-kid=\"12\">\n        <i class=\"ti ti-calendar-event text-lg\" data-kid=\"13\"></i>\n        <span data-kid=\"14\">Calendario</span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all text-sm font-medium\" data-kid=\"15\">\n        <i class=\"ti ti-users text-lg\" data-kid=\"16\"></i>\n        <span data-kid=\"17\">Personal</span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all text-sm font-medium\" data-kid=\"18\">\n        <i class=\"ti ti-report-money text-lg\" data-kid=\"19\"></i>\n        <span data-kid=\"20\">Finanzas</span>\n      </a>\n      \n      <p class=\"px-2 text-[10px] font-bold uppercase tracking-widest text-slate-500 mt-8 mb-2\" data-kid=\"21\">Administración</p>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all text-sm font-medium\" data-kid=\"22\">\n        <i class=\"ti ti-building-hospital text-lg\" data-kid=\"23\"></i>\n        <span data-kid=\"24\">Sedes</span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all text-sm font-medium\" data-kid=\"25\">\n        <i class=\"ti ti-settings text-lg\" data-kid=\"26\"></i>\n        <span data-kid=\"27\">Configuración</span>\n      </a>\n    </nav>\n\n    <div class=\"p-4 mt-auto\" data-kid=\"28\">\n      <div class=\"bg-slate-800/40 rounded-2xl p-4 border border-white/5\" data-kid=\"29\">\n        <div class=\"flex items-center gap-3 mb-3\" data-kid=\"30\">\n          <div class=\"w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-400\" data-kid=\"31\">\n            <i class=\"ti ti-crown\" data-kid=\"32\"></i>\n          </div>\n          <span class=\"text-xs font-bold text-white uppercase tracking-tighter leading-none\" data-kid=\"33\">Plan Pro</span>\n        </div>\n        <p class=\"text-[10px] text-slate-400 mb-3\" data-kid=\"34\">Tu suscripción vence en 12 días.</p>\n        <button class=\"w-full py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-[11px] font-bold transition-all\" data-kid=\"35\">Renovar ahora</button>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 ml-64 p-8\" data-kid=\"36\">\n    \n    <header class=\"flex items-center justify-between mb-10\" data-kid=\"37\">\n      <div data-kid=\"38\">\n        <h1 class=\"font-serif text-3xl text-slate-900 mb-1\" data-kid=\"39\">Resumen de Clínica</h1>\n        <p class=\"text-sm text-slate-500 font-medium\" data-kid=\"40\">Miércoles, 15 de Octubre 2026</p>\n      </div>\n      <div class=\"flex items-center gap-4\" data-kid=\"41\">\n        <div class=\"relative\" data-kid=\"42\">\n          <input type=\"text\" placeholder=\"Buscar pacientes o citas...\" class=\"w-64 pl-11 pr-4 py-2.5 bg-white border border-slate-200 rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\" data-kid=\"43\">\n          <i class=\"ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400\" data-kid=\"44\"></i>\n        </div>\n        <button class=\"w-11 h-11 flex items-center justify-center bg-white border border-slate-200 rounded-2xl text-slate-600 hover:bg-slate-50 transition-all relative\" data-kid=\"45\">\n          <i class=\"ti ti-bell text-lg\" data-kid=\"46\"></i>\n          <span class=\"absolute top-2.5 right-2.5 w-2 h-2 bg-rose-500 border-2 border-white rounded-full\" data-kid=\"47\"></span>\n        </button>\n        <div class=\"h-11 w-[1px] bg-slate-200 mx-1\" data-kid=\"48\"></div>\n        <div class=\"flex items-center gap-3 pl-2\" data-kid=\"49\">\n          <div class=\"text-right\" data-kid=\"50\">\n            <p class=\"text-sm font-bold text-slate-900 leading-none\" data-kid=\"51\">Rafael Medina</p>\n            <p class=\"text-[10px] font-bold text-slate-400 uppercase tracking-tighter mt-1\" data-kid=\"52\">Administrador</p>\n          </div>\n          <img src=\"https://i.pravatar.cc/150?u=rafael\" alt=\"Avatar\" class=\"w-11 h-11 rounded-2xl object-cover ring-2 ring-white shadow-sm\" data-kid=\"53\">\n        </div>\n      </div>\n    </header>\n\n    \n    <div class=\"grid grid-cols-4 gap-6 mb-8\" data-kid=\"54\">\n      \n      <div class=\"ticket-stub bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex flex-col justify-between h-32 group hover:shadow-md transition-all\" data-kid=\"55\">\n        <div class=\"flex items-center justify-between\" data-kid=\"56\">\n          <span class=\"text-[11px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"57\">Ocupación Total</span>\n          <div class=\"px-2 py-0.5 bg-emerald-50 text-emerald-600 rounded-full text-[10px] font-bold\" data-kid=\"58\">+12%</div>\n        </div>\n        <div class=\"flex items-end justify-between\" data-kid=\"59\">\n          <h2 class=\"font-serif text-3xl text-slate-900\" data-kid=\"60\">84<span class=\"text-xl font-sans\" data-kid=\"61\">%</span></h2>\n          <i class=\"ti ti-chart-pie text-slate-200 text-3xl group-hover:text-blue-500/20 transition-all\" data-kid=\"62\"></i>\n        </div>\n      </div>\n      \n      <div class=\"ticket-stub bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex flex-col justify-between h-32 group hover:shadow-md transition-all\" data-kid=\"63\">\n        <div class=\"flex items-center justify-between\" data-kid=\"64\">\n          <span class=\"text-[11px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"65\">Ingresos Hoy</span>\n          <div class=\"px-2 py-0.5 bg-emerald-50 text-emerald-600 rounded-full text-[10px] font-bold\" data-kid=\"66\">+5.4%</div>\n        </div>\n        <div class=\"flex items-end justify-between\" data-kid=\"67\">\n          <h2 class=\"font-serif text-3xl text-slate-900\" data-kid=\"68\"><span class=\"text-xl font-sans\" data-kid=\"69\">$</span>2,840</h2>\n          <i class=\"ti ti-cash text-slate-200 text-3xl group-hover:text-emerald-500/20 transition-all\" data-kid=\"70\"></i>\n        </div>\n      </div>\n      \n      <div class=\"ticket-stub bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex flex-col justify-between h-32 group hover:shadow-md transition-all\" data-kid=\"71\">\n        <div class=\"flex items-center justify-between\" data-kid=\"72\">\n          <span class=\"text-[11px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"73\">Citas Canceladas</span>\n          <div class=\"px-2 py-0.5 bg-rose-50 text-rose-600 rounded-full text-[10px] font-bold\" data-kid=\"74\">-2</div>\n        </div>\n        <div class=\"flex items-end justify-between\" data-kid=\"75\">\n          <h2 class=\"font-serif text-3xl text-slate-900\" data-kid=\"76\">3</h2>\n          <i class=\"ti ti-calendar-cancel text-slate-200 text-3xl group-hover:text-rose-500/20 transition-all\" data-kid=\"77\"></i>\n        </div>\n      </div>\n      \n      <div class=\"ticket-stub bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex flex-col justify-between h-32 group hover:shadow-md transition-all\" data-kid=\"78\">\n        <div class=\"flex items-center justify-between\" data-kid=\"79\">\n          <span class=\"text-[11px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"80\">Nuevos Pacientes</span>\n          <div class=\"px-2 py-0.5 bg-emerald-50 text-emerald-600 rounded-full text-[10px] font-bold\" data-kid=\"81\">+8</div>\n        </div>\n        <div class=\"flex items-end justify-between\" data-kid=\"82\">\n          <h2 class=\"font-serif text-3xl text-slate-900\" data-kid=\"83\">24</h2>\n          <i class=\"ti ti-user-plus text-slate-200 text-3xl group-hover:text-amber-500/20 transition-all\" data-kid=\"84\"></i>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100 mb-8 relative overflow-hidden\" data-kid=\"85\">\n      <div class=\"relative z-10\" data-kid=\"86\">\n        <div class=\"flex items-center justify-between mb-8\" data-kid=\"87\">\n          <div data-kid=\"88\">\n            <h3 class=\"font-serif text-2xl text-slate-900\" data-kid=\"89\">Tendencias de Operación</h3>\n            <p class=\"text-xs text-slate-500 font-medium\" data-kid=\"90\">Comparativa semanal de citas vs ingresos</p>\n          </div>\n          <div class=\"flex items-center gap-2\" data-kid=\"91\">\n            <button class=\"px-4 py-2 bg-slate-50 text-slate-600 rounded-xl text-xs font-bold hover:bg-slate-100 transition-all\" data-kid=\"92\">Semanas</button>\n            <button class=\"px-4 py-2 bg-blue-600 text-white rounded-xl text-xs font-bold shadow-lg shadow-blue-500/20\" data-kid=\"93\">Meses</button>\n          </div>\n        </div>\n        \n        <div class=\"h-[300px]\" data-kid=\"94\">\n          <canvas id=\"trendsChart\" data-kid=\"95\"></canvas>\n        </div>\n      </div>\n      \n      \n      <img src=\"https://images.unsplash.com/photo-1765445773850-8b08ced4b7c1?auto=format&w=800&q=80&fit=crop\" alt=\"bg\" class=\"absolute inset-0 w-full h-full object-cover opacity-[0.03] pointer-events-none grayscale mix-blend-overlay\" data-kid=\"96\">\n    </div>\n\n    \n    <div class=\"grid grid-cols-12 gap-8\" data-kid=\"97\">\n      \n      <div class=\"col-span-8 bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100\" data-kid=\"98\">\n        <div class=\"flex items-center justify-between mb-8\" data-kid=\"99\">\n          <h3 class=\"font-serif text-2xl text-slate-900\" data-kid=\"100\">Disponibilidad de Especialistas</h3>\n          <div class=\"flex items-center gap-2 text-xs font-bold text-slate-400\" data-kid=\"101\">\n             <div class=\"flex items-center gap-1.5\" data-kid=\"102\"><span class=\"w-2 h-2 rounded-full bg-blue-500\" data-kid=\"103\"></span> Reservado</div>\n             <div class=\"flex items-center gap-1.5 ml-4\" data-kid=\"104\"><span class=\"w-2 h-2 rounded-full bg-slate-100\" data-kid=\"105\"></span> Libre</div>\n          </div>\n        </div>\n\n        <div class=\"space-y-6 overflow-x-auto custom-scroll pb-4\" data-kid=\"106\">\n          \n          <div class=\"flex items-center gap-4 min-w-[700px]\" data-kid=\"107\">\n            <div class=\"w-40 shrink-0\" data-kid=\"108\"></div>\n            <div class=\"flex-1 flex justify-between px-2 text-[10px] font-bold text-slate-400 uppercase tracking-tighter\" data-kid=\"109\">\n              <span data-kid=\"110\">08:00</span><span data-kid=\"111\">09:00</span><span data-kid=\"112\">10:00</span><span data-kid=\"113\">11:00</span><span data-kid=\"114\">12:00</span><span data-kid=\"115\">13:00</span><span data-kid=\"116\">14:00</span><span data-kid=\"117\">15:00</span><span data-kid=\"118\">16:00</span>\n            </div>\n          </div>\n\n          \n          <div class=\"flex items-center gap-4 min-w-[700px]\" data-kid=\"119\">\n            <div class=\"w-40 shrink-0 flex items-center gap-3\" data-kid=\"120\">\n              <img src=\"https://i.pravatar.cc/100?u=dr1\" alt=\"dr\" class=\"w-9 h-9 rounded-xl object-cover\" data-kid=\"121\">\n              <div class=\"min-w-0\" data-kid=\"122\">\n                <p class=\"text-xs font-bold truncate\" data-kid=\"123\">Dr. Gutiérrez</p>\n                <p class=\"text-[10px] text-slate-400 font-medium\" data-kid=\"124\">Cardiología</p>\n              </div>\n            </div>\n            <div class=\"flex-1 h-10 bg-slate-50 rounded-xl relative overflow-hidden flex items-center px-1\" data-kid=\"125\">\n              <div class=\"absolute left-[10%] w-[25%] h-7 bg-blue-500/10 border border-blue-200 rounded-lg flex items-center px-2\" data-kid=\"126\">\n                <span class=\"text-[9px] font-bold text-blue-600 truncate\" data-kid=\"127\">Cita: Carlos B.</span>\n              </div>\n              <div class=\"absolute left-[45%] w-[15%] h-7 bg-blue-600 shadow-md shadow-blue-500/20 rounded-lg flex items-center px-2\" data-kid=\"128\">\n                <span class=\"text-[9px] font-bold text-white truncate\" data-kid=\"129\">Urgencia</span>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"flex items-center gap-4 min-w-[700px]\" data-kid=\"130\">\n            <div class=\"w-40 shrink-0 flex items-center gap-3\" data-kid=\"131\">\n              <img src=\"https://i.pravatar.cc/100?u=dr2\" alt=\"dr\" class=\"w-9 h-9 rounded-xl object-cover\" data-kid=\"132\">\n              <div class=\"min-w-0\" data-kid=\"133\">\n                <p class=\"text-xs font-bold truncate\" data-kid=\"134\">Dra. Fernández</p>\n                <p class=\"text-[10px] text-slate-400 font-medium\" data-kid=\"135\">Pediatría</p>\n              </div>\n            </div>\n            <div class=\"flex-1 h-10 bg-slate-50 rounded-xl relative overflow-hidden flex items-center px-1\" data-kid=\"136\">\n              <div class=\"absolute left-[5%] w-[40%] h-7 bg-blue-500/10 border border-blue-200 rounded-lg flex items-center px-2\" data-kid=\"137\">\n                <span class=\"text-[9px] font-bold text-blue-600 truncate\" data-kid=\"138\">Control Prenatal (3)</span>\n              </div>\n              <div class=\"absolute left-[70%] w-[20%] h-7 bg-blue-500/10 border border-blue-200 rounded-lg flex items-center px-2\" data-kid=\"139\">\n                <span class=\"text-[9px] font-bold text-blue-600 truncate\" data-kid=\"140\">Consulta</span>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"flex items-center gap-4 min-w-[700px]\" data-kid=\"141\">\n            <div class=\"w-40 shrink-0 flex items-center gap-3\" data-kid=\"142\">\n              <img src=\"https://i.pravatar.cc/100?u=dr3\" alt=\"dr\" class=\"w-9 h-9 rounded-xl object-cover\" data-kid=\"143\">\n              <div class=\"min-w-0\" data-kid=\"144\">\n                <p class=\"text-xs font-bold truncate\" data-kid=\"145\">Dra. Leiva</p>\n                <p class=\"text-[10px] text-slate-400 font-medium\" data-kid=\"146\">Dermatología</p>\n              </div>\n            </div>\n            <div class=\"flex-1 h-10 bg-slate-50 rounded-xl relative overflow-hidden flex items-center px-1\" data-kid=\"147\">\n              <div class=\"absolute left-[30%] w-[30%] h-7 bg-blue-500/10 border border-blue-200 rounded-lg flex items-center px-2\" data-kid=\"148\">\n                <span class=\"text-[9px] font-bold text-blue-600 truncate\" data-kid=\"149\">Bloqueado: Almuerzo</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-4 bg-[#0F172A] rounded-[2rem] p-8 shadow-sm text-white relative overflow-hidden\" data-kid=\"150\">\n        <div class=\"absolute top-0 right-0 w-32 h-32 bg-blue-500/10 blur-3xl rounded-full\" data-kid=\"151\"></div>\n        \n        <h3 class=\"font-serif text-2xl mb-8 relative z-10\" data-kid=\"152\">Actividad Reciente</h3>\n        \n        <div class=\"space-y-8 relative z-10\" data-kid=\"153\">\n          \n          <div class=\"flex gap-4 group\" data-kid=\"154\">\n            <div class=\"w-10 h-10 shrink-0 bg-blue-600 scalloped-icon flex items-center justify-center text-white group-hover:scale-110 transition-all\" data-kid=\"155\">\n              <i class=\"ti ti-credit-card text-lg\" data-kid=\"156\"></i>\n            </div>\n            <div data-kid=\"157\">\n              <p class=\"text-xs font-bold mb-1\" data-kid=\"158\">Pago recibido <span class=\"text-blue-400\" data-kid=\"159\">$120.00</span></p>\n              <p class=\"text-[10px] text-slate-400\" data-kid=\"160\">Paciente: Ana Banana • Dr. Gutiérrez</p>\n              <p class=\"text-[9px] font-bold text-slate-500 uppercase mt-1\" data-kid=\"161\">Hace 12 mins</p>\n            </div>\n          </div>\n\n          \n          <div class=\"flex gap-4 group\" data-kid=\"162\">\n            <div class=\"w-10 h-10 shrink-0 bg-emerald-600 scalloped-icon flex items-center justify-center text-white group-hover:scale-110 transition-all\" data-kid=\"163\">\n              <i class=\"ti ti-user-check text-lg\" data-kid=\"164\"></i>\n            </div>\n            <div data-kid=\"165\">\n              <p class=\"text-xs font-bold mb-1\" data-kid=\"166\">Ingreso de Paciente</p>\n              <p class=\"text-[10px] text-slate-400\" data-kid=\"167\">Roberto Carle ha llegado a recepción.</p>\n              <p class=\"text-[9px] font-bold text-slate-500 uppercase mt-1\" data-kid=\"168\">Hace 25 mins</p>\n            </div>\n          </div>\n\n          \n          <div class=\"flex gap-4 group\" data-kid=\"169\">\n            <div class=\"w-10 h-10 shrink-0 bg-amber-600 scalloped-icon flex items-center justify-center text-white group-hover:scale-110 transition-all\" data-kid=\"170\">\n              <i class=\"ti ti-alert-circle text-lg\" data-kid=\"171\"></i>\n            </div>\n            <div data-kid=\"172\">\n              <p class=\"text-xs font-bold mb-1\" data-kid=\"173\">Reprogramación</p>\n              <p class=\"text-[10px] text-slate-400\" data-kid=\"174\">Dra. Fernández cambió su horario de mañana.</p>\n              <p class=\"text-[9px] font-bold text-slate-500 uppercase mt-1\" data-kid=\"175\">Hace 1 hora</p>\n            </div>\n          </div>\n\n          \n          <div class=\"flex gap-4 group\" data-kid=\"176\">\n            <div class=\"w-10 h-10 shrink-0 bg-slate-700 scalloped-icon flex items-center justify-center text-white group-hover:scale-110 transition-all\" data-kid=\"177\">\n              <i class=\"ti ti-file-text text-lg\" data-kid=\"178\"></i>\n            </div>\n            <div data-kid=\"179\">\n              <p class=\"text-xs font-bold mb-1\" data-kid=\"180\">Nuevo Reporte Mensual</p>\n              <p class=\"text-[10px] text-slate-400\" data-kid=\"181\">Se ha generado el resumen financiero de Septiembre.</p>\n              <p class=\"text-[9px] font-bold text-slate-500 uppercase mt-1\" data-kid=\"182\">Hace 4 horas</p>\n            </div>\n          </div>\n        </div>\n\n        <button class=\"w-full mt-10 py-3 bg-white/5 hover:bg-white/10 rounded-2xl text-xs font-bold tracking-tight transition-all border border-white/5\" data-kid=\"183\">\n          Ver todo el historial\n        </button>\n      </div>\n    </div>\n  </main>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"184\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\" data-kid=\"185\"></script>\n<script data-kid=\"186\">\n  window.addEventListener('load', () => {\n    const ctx = document.getElementById('trendsChart').getContext('2d');\n    \n    new Chart(ctx, {\n      type: 'line',\n      data: {\n        labels: ['Lun', 'Mar', 'Mie', 'Jue', 'Vie', 'Sab', 'Dom'],\n        datasets: [{\n          label: 'Citas',\n          data: [65, 59, 80, 81, 56, 40, 45],\n          borderColor: '#3B82F6',\n          backgroundColor: 'rgba(59, 130, 246, 0.05)',\n          fill: true,\n          tension: 0.4,\n          borderWidth: 3,\n          pointRadius: 0,\n          pointHoverRadius: 6,\n          pointHoverBackgroundColor: '#3B82F6',\n          pointHoverBorderColor: '#fff',\n          pointHoverBorderWidth: 3\n        }, {\n          label: 'Ingresos ($k)',\n          data: [28, 48, 40, 19, 86, 27, 90],\n          borderColor: '#10B981',\n          backgroundColor: 'transparent',\n          fill: false,\n          tension: 0.4,\n          borderWidth: 2,\n          borderDash: [5, 5],\n          pointRadius: 0\n        }]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: {\n          legend: { display: false }\n        },\n        scales: {\n          y: {\n            display: false,\n            grid: { display: false }\n          },\n          x: {\n            grid: { display: false },\n            ticks: {\n              color: '#94A3B8',\n              font: { weight: 'bold', size: 10 }\n            }\n          }\n        },\n        interaction: {\n          intersect: false,\n          mode: 'index'\n        }\n      }\n    });\n\n    // Simple fade in animations\n    gsap.from('aside', { x: -60, opacity: 0, duration: 0.8, ease: 'power3.out' });\n    gsap.from('header', { y: -20, opacity: 0, duration: 0.8, delay: 0.2, ease: 'power3.out' });\n    gsap.from('.ticket-stub', { scale: 0.9, opacity: 0, duration: 0.6, delay: 0.4, stagger: 0.1, ease: 'back.out(1.7)' });\n    gsap.from('.col-span-8, .col-span-4', { y: 40, opacity: 0, duration: 0.8, delay: 0.6, ease: 'power3.out' });\n  });\n</script>",
