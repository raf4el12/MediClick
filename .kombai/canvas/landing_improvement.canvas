      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@600;700&display=swap');\n\n  .font-serif {\n    font-family: 'Lora', serif;\n  }\n  .font-sans {\n    font-family: 'Inter', sans-serif;\n  }\n\n  .text-gradient {\n    background: linear-gradient(135deg, #0E9F9F 0%, #2563EB 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .radial-bg {\n    background: radial-gradient(circle at center, rgba(14, 159, 159, 0.15) 0%, transparent 70%);\n  }\n\n  .bento-mask {\n    mask-image: linear-gradient(to bottom, black 70%, transparent 100%);\n    -webkit-mask-image: linear-gradient(to bottom, black 70%, transparent 100%);\n  }\n\n  .floating-card {\n    animation: float 6s ease-in-out infinite;\n  }\n\n  @keyframes float {\n    0% { transform: translateY(0px); }\n    50% { transform: translateY(-10px); }\n    100% { transform: translateY(0px); }\n  }\n\n  .transition-soft {\n    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n</style>\n\n<div class=\"font-sans text-[#111827] bg-white overflow-hidden\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-black/5\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-2\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-[#2563EB] rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/20\" data-kid=\"5\">\n          <i class=\"ri-heart-pulse-fill text-white text-xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"text-xl font-bold tracking-tight\" data-kid=\"7\">MediClick</span>\n      </div>\n      \n      <div class=\"hidden md:flex items-center gap-10\" data-kid=\"8\">\n        <a href=\"#\" class=\"text-sm font-semibold text-gray-500 hover:text-black transition-colors\" data-kid=\"9\">Funciones</a>\n        <a href=\"#\" class=\"text-sm font-semibold text-gray-500 hover:text-black transition-colors\" data-kid=\"10\">Nosotros</a>\n        <a href=\"#\" class=\"text-sm font-semibold text-gray-500 hover:text-black transition-colors\" data-kid=\"11\">Blog</a>\n        <a href=\"#\" class=\"text-sm font-semibold text-gray-500 hover:text-black transition-colors\" data-kid=\"12\">Soporte</a>\n      </div>\n\n      <div class=\"flex items-center gap-4\" data-kid=\"13\">\n        <a href=\"#\" class=\"px-6 py-2.5 text-sm font-bold text-gray-700 hover:bg-gray-50 rounded-full transition-soft\" data-kid=\"14\">Ingresa</a>\n        <a href=\"#\" class=\"px-6 py-2.5 text-sm font-bold bg-[#2563EB] text-white rounded-full shadow-lg shadow-blue-500/20 hover:scale-105 transition-soft\" data-kid=\"15\">Regístrate</a>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative pt-48 pb-24 text-center\" data-kid=\"16\">\n    <div class=\"max-w-4xl mx-auto px-6\" data-kid=\"17\">\n      <h1 class=\"font-serif text-6xl md:text-7xl leading-[1.1] mb-8\" data-kid=\"18\">\n        No has estudiado medicina para <span class=\"text-[#0E9F9F]\" data-kid=\"19\">perder los papeles.</span>\n      </h1>\n      <p class=\"text-xl text-gray-500 leading-relaxed max-w-2xl mx-auto mb-12\" data-kid=\"20\">\n        Ahorra más de 3 horas al día con la única historia clínica electrónica con Inteligencia Artificial, diseñada para el médico.\n      </p>\n      \n      <div class=\"flex flex-wrap items-center justify-center gap-4 mb-20\" data-kid=\"21\">\n        <button class=\"px-8 py-4 bg-[#0E9F9F] text-white font-bold rounded-full shadow-xl shadow-teal-500/20 hover:scale-105 transition-soft\" data-kid=\"22\">\n          Crea tu cuenta gratis\n        </button>\n        <button class=\"px-8 py-4 bg-black text-white font-bold rounded-full hover:scale-105 transition-soft\" data-kid=\"23\">\n          Agenda una demo\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"relative max-w-6xl mx-auto px-6\" data-kid=\"24\">\n      <div class=\"absolute inset-0 radial-bg pointer-events-none translate-y-20\" data-kid=\"25\"></div>\n      \n      <div class=\"relative z-10 flex justify-center\" data-kid=\"26\">\n        \n        <div class=\"relative group\" data-kid=\"27\">\n          <div class=\"bg-black p-2 rounded-[2rem] shadow-2xl overflow-hidden border-4 border-gray-800 transition-soft group-hover:rotate-x-2\" data-kid=\"28\">\n            <img src=\"https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&w=1280&q=80&fit=crop\" alt=\"MediClick Dashboard\" class=\"w-[900px] aspect-[16/10] object-cover rounded-[1.5rem]\" loading=\"lazy\" decoding=\"async\" data-kid=\"29\">\n          </div>\n\n          \n          <div class=\"absolute -top-12 -left-12 w-64 p-4 bg-white rounded-2xl shadow-xl border border-black/5 floating-card text-left\" data-kid=\"30\">\n            <div class=\"flex items-center gap-3 mb-3\" data-kid=\"31\">\n              <div class=\"w-10 h-10 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold\" data-kid=\"32\">FL</div>\n              <div data-kid=\"33\">\n                <p class=\"text-xs font-bold\" data-kid=\"34\">Felipe Lopez</p>\n                <p class=\"text-[10px] text-gray-400\" data-kid=\"35\">Ver perfil</p>\n              </div>\n            </div>\n            <div class=\"space-y-2\" data-kid=\"36\">\n              <div class=\"h-1 bg-gray-100 rounded-full w-full\" data-kid=\"37\"></div>\n              <div class=\"h-1 bg-gray-100 rounded-full w-2/3\" data-kid=\"38\"></div>\n            </div>\n          </div>\n\n          <div class=\"absolute top-1/4 -right-16 w-56 p-4 bg-white rounded-2xl shadow-xl border border-black/5 floating-card text-left\" style=\"animation-delay: -1s;\" data-kid=\"39\">\n            <p class=\"text-xs font-bold text-gray-400 mb-3 uppercase tracking-wider\" data-kid=\"40\">Últimas atenciones</p>\n            <div class=\"space-y-3\" data-kid=\"41\">\n              <div class=\"flex justify-between items-center\" data-kid=\"42\">\n                <span class=\"text-[11px] font-semibold\" data-kid=\"43\">Diabetes Mellitus</span>\n                <span class=\"text-[9px] px-2 py-0.5 bg-green-100 text-green-700 rounded-full\" data-kid=\"44\">Medicina</span>\n              </div>\n              <div class=\"flex justify-between items-center\" data-kid=\"45\">\n                <span class=\"text-[11px] font-semibold\" data-kid=\"46\">Hipertensión arterial</span>\n                <span class=\"text-[9px] px-2 py-0.5 bg-blue-100 text-blue-700 rounded-full\" data-kid=\"47\">Enfermería</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-20 border-y border-black/5\" data-kid=\"48\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"49\">\n      <p class=\"text-center text-sm font-bold text-gray-400 uppercase tracking-[0.2em] mb-12\" data-kid=\"50\">Únete a miles de doctores de los mejores hospitales que ya usan MediClick</p>\n      <div class=\"flex flex-wrap items-center justify-center gap-12 grayscale opacity-40\" data-kid=\"51\">\n        <img src=\"https://framerusercontent.com/images/kfuQ1NgPLlh8gDK3XDb83iPZelc.png?width=200\" alt=\"Hospital Logo\" class=\"h-8\" data-kid=\"52\">\n        <img src=\"https://framerusercontent.com/images/9L8S8EhqIxrlCxEYaL68MaI8fI.png?width=200\" alt=\"Hospital Logo\" class=\"h-8\" data-kid=\"53\">\n        <img src=\"https://framerusercontent.com/images/JDdzy6yJ4eHIJSXQP0lbdRJ9gJ0.png?width=200\" alt=\"Hospital Logo\" class=\"h-8\" data-kid=\"54\">\n        <img src=\"https://framerusercontent.com/images/3TTRp9KWvKhCOdMh65dLIXu47ZI.png?width=200\" alt=\"Hospital Logo\" class=\"h-8\" data-kid=\"55\">\n        <img src=\"https://framerusercontent.com/images/53v1oxDQuQNp8Y76yEz4aEQJ3Fg.png?width=200\" alt=\"Hospital Logo\" class=\"h-8\" data-kid=\"56\">\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-[#FAFAFA]\" data-kid=\"57\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"58\">\n      <div class=\"text-center mb-24\" data-kid=\"59\">\n        <h2 class=\"font-serif text-5xl mb-6\" data-kid=\"60\">Todo en un mismo lugar</h2>\n        <p class=\"text-xl text-gray-500 max-w-2xl mx-auto\" data-kid=\"61\">Historias clínicas, imágenes, notas, agenda, archivos, finanzas. Ahora con IA.</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-20 items-center mb-40\" data-kid=\"62\">\n        <div data-kid=\"63\">\n          <h3 class=\"font-serif text-4xl mb-6\" data-kid=\"64\">Historia clínica inteligente</h3>\n          <p class=\"text-lg text-gray-500 leading-relaxed mb-8\" data-kid=\"65\">\n            Diseñada por médicos para médicos. Un sistema que piensa como tu, así puedes concentrarte en tus pacientes y no en los papeles.\n          </p>\n          <a href=\"#\" class=\"inline-flex items-center gap-2 font-bold text-[#0E9F9F] group\" data-kid=\"66\">\n            Ver más\n            <i class=\"ri-arrow-right-line group-hover:translate-x-1 transition-transform\" data-kid=\"67\"></i>\n          </a>\n        </div>\n        <div class=\"relative group\" data-kid=\"68\">\n          <div class=\"bg-white p-6 rounded-3xl shadow-xl border border-black/5 transition-soft group-hover:scale-[1.02]\" data-kid=\"69\">\n            <img src=\"https://framerusercontent.com/images/Tto03AblejVd7fDWsPZJM42Yp4.png?width=800\" alt=\"Feature\" class=\"rounded-xl\" data-kid=\"70\">\n          </div>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-20 items-center\" data-kid=\"71\">\n        <div class=\"order-2 md:order-1 relative group\" data-kid=\"72\">\n          <div class=\"bg-white p-6 rounded-3xl shadow-xl border border-black/5 transition-soft group-hover:scale-[1.02]\" data-kid=\"73\">\n            <div class=\"aspect-video bg-gray-50 rounded-xl overflow-hidden flex items-center justify-center\" data-kid=\"74\">\n               <i class=\"ri-video-chat-fill text-6xl text-teal-200\" data-kid=\"75\"></i>\n            </div>\n          </div>\n        </div>\n        <div class=\"order-1 md:order-2\" data-kid=\"76\">\n          <h3 class=\"font-serif text-4xl mb-6\" data-kid=\"77\">Tu consultorio en tu bolsillo</h3>\n          <p class=\"text-lg text-gray-500 leading-relaxed mb-8\" data-kid=\"78\">\n            Atiende a un paciente desde cualquier lugar y a cualquier hora. Atiende cuando quieras, como quieras, donde quieras.\n          </p>\n          <a href=\"#\" class=\"inline-flex items-center gap-2 font-bold text-[#0E9F9F] group\" data-kid=\"79\">\n            Explorar app móvil\n            <i class=\"ri-arrow-right-line group-hover:translate-x-1 transition-transform\" data-kid=\"80\"></i>\n          </a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-white relative\" data-kid=\"81\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"82\">\n      <div class=\"text-center mb-20\" data-kid=\"83\">\n        <h2 class=\"font-serif text-5xl mb-6\" data-kid=\"84\">\"Como magia.\"</h2>\n        <p class=\"text-xl text-gray-500\" data-kid=\"85\">A nuestros clientes les encanta lo fácil que es usar MediClick.</p>\n      </div>\n\n      <div class=\"bento-mask pb-20\" data-kid=\"86\">\n        <div class=\"columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6\" data-kid=\"87\">\n          \n          <div class=\"break-inside-avoid p-8 bg-white rounded-3xl border border-black/5 shadow-sm hover:shadow-xl transition-soft\" data-kid=\"88\">\n            <p class=\"text-gray-600 leading-relaxed mb-8 italic\" data-kid=\"89\">\"Doctoc es muy sencillo y muy fácil de usar. Ahora tenemos mucho más tiempo para nuestros pacientes.\"</p>\n            <div class=\"flex items-center gap-4\" data-kid=\"90\">\n              <img src=\"https://i.pravatar.cc/100?u=dr1\" alt=\"Dr. Enrique\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"91\">\n              <div data-kid=\"92\">\n                <p class=\"font-bold text-sm\" data-kid=\"93\">Dr. Enrique Malpartida</p>\n                <p class=\"text-xs text-gray-400\" data-kid=\"94\">Novapiel</p>\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"break-inside-avoid p-8 bg-[#F0FBFA] rounded-3xl border border-teal-100 shadow-sm hover:shadow-xl transition-soft\" data-kid=\"95\">\n            <p class=\"text-gray-600 leading-relaxed mb-8 italic\" data-kid=\"96\">\"Me es mucho más fácil el crear una historia clínica para un paciente nuevo, escribir el relato y colocar los diagnósticos dado que tiene todo el CIE-10 integrado.\"</p>\n            <div class=\"flex items-center gap-4\" data-kid=\"97\">\n              <img src=\"https://i.pravatar.cc/100?u=dr2\" alt=\"Dr. Jorge\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"98\">\n              <div data-kid=\"99\">\n                <p class=\"font-bold text-sm\" data-kid=\"100\">Dr. Jorge Luis Espinoza</p>\n                <p class=\"text-xs text-gray-400\" data-kid=\"101\">Clínica San Felipe</p>\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"break-inside-avoid p-8 bg-white rounded-3xl border border-black/5 shadow-sm hover:shadow-xl transition-soft\" data-kid=\"102\">\n            <p class=\"text-gray-600 leading-relaxed mb-8 italic\" data-kid=\"103\">\"Doctoc se ha adaptado muy bien a las necesidades de nuestro centro. Quiero destacar el soporte que hemos recibido.\"</p>\n            <div class=\"flex items-center gap-4\" data-kid=\"104\">\n              <img src=\"https://i.pravatar.cc/100?u=dr3\" alt=\"Dr. Edwin\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"105\">\n              <div data-kid=\"106\">\n                <p class=\"font-bold text-sm\" data-kid=\"107\">Dr. Edwin Caballero</p>\n                <p class=\"text-xs text-gray-400\" data-kid=\"108\">CardioHealth</p>\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"break-inside-avoid p-8 bg-white rounded-3xl border border-black/5 shadow-sm hover:shadow-xl transition-soft\" data-kid=\"109\">\n            <p class=\"text-gray-600 leading-relaxed mb-8 italic\" data-kid=\"110\">\"Definitivamente lo recomiendo por su versatilidad en distintos dispositivos móviles y de escritorio.\"</p>\n            <div class=\"flex items-center gap-4\" data-kid=\"111\">\n              <img src=\"https://i.pravatar.cc/100?u=dr4\" alt=\"Dr. Gumer\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"112\">\n              <div data-kid=\"113\">\n                <p class=\"font-bold text-sm\" data-kid=\"114\">Dr. Gumer Lozano</p>\n                <p class=\"text-xs text-gray-400\" data-kid=\"115\">Clínica El Golf</p>\n              </div>\n            </div>\n          </div>\n           \n          <div class=\"break-inside-avoid p-8 bg-[#F5F8FF] rounded-3xl border border-blue-100 shadow-sm hover:shadow-xl transition-soft\" data-kid=\"116\">\n            <p class=\"text-gray-600 leading-relaxed mb-8 italic\" data-kid=\"117\">\"La mejor inversión que hemos hecho para la gestión administrativa de la clínica.\"</p>\n            <div class=\"flex items-center gap-4\" data-kid=\"118\">\n              <img src=\"https://i.pravatar.cc/100?u=dr5\" alt=\"Dr. Jose\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"119\">\n              <div data-kid=\"120\">\n                <p class=\"font-bold text-sm\" data-kid=\"121\">Dr. José Cabala</p>\n                <p class=\"text-xs text-gray-400\" data-kid=\"122\">Mundo Sin Cáncer</p>\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"break-inside-avoid p-8 bg-white rounded-3xl border border-black/5 shadow-sm hover:shadow-xl transition-soft\" data-kid=\"123\">\n            <p class=\"text-gray-600 leading-relaxed mb-8 italic\" data-kid=\"124\">\"Todo lo manejo desde la comodidad de mi celular con pocos clicks.\"</p>\n            <div class=\"flex items-center gap-4\" data-kid=\"125\">\n              <img src=\"https://i.pravatar.cc/100?u=dr6\" alt=\"Dra. Natali\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"126\">\n              <div data-kid=\"127\">\n                <p class=\"font-bold text-sm\" data-kid=\"128\">Dra. Natalí Leiva</p>\n                <p class=\"text-xs text-gray-400\" data-kid=\"129\">Clínica San Felipe</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-6 py-24\" data-kid=\"130\">\n    <div class=\"max-w-7xl mx-auto bg-[#053B4B] rounded-[3rem] p-12 md:p-24 text-center text-white relative overflow-hidden\" data-kid=\"131\">\n      <div class=\"absolute top-0 right-0 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl\" data-kid=\"132\"></div>\n      <div class=\"absolute bottom-0 left-0 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl\" data-kid=\"133\"></div>\n      \n      <div class=\"relative z-10\" data-kid=\"134\">\n        <h2 class=\"font-serif text-5xl md:text-6xl mb-8 leading-tight\" data-kid=\"135\">¿Qué estás esperando?</h2>\n        <p class=\"text-xl text-teal-100/60 max-w-2xl mx-auto mb-12\" data-kid=\"136\">Maneja tu atención médica con herramientas poderosas y deja atrás las complicaciones administrativas.</p>\n        <div class=\"flex flex-wrap items-center justify-center gap-4\" data-kid=\"137\">\n          <button class=\"px-10 py-5 bg-white text-[#053B4B] font-bold rounded-full hover:scale-105 transition-soft\" data-kid=\"138\">\n            Crea tu cuenta gratis\n          </button>\n          <button class=\"px-10 py-5 bg-white/10 text-white font-bold rounded-full hover:bg-white/20 transition-soft\" data-kid=\"139\">\n            Agenda una demo\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 border-t border-black/5 bg-white\" data-kid=\"140\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"141\">\n      <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-12 mb-20\" data-kid=\"142\">\n        <div class=\"col-span-2 lg:col-span-2\" data-kid=\"143\">\n          <div class=\"flex items-center gap-2 mb-6\" data-kid=\"144\">\n            <div class=\"w-8 h-8 bg-[#2563EB] rounded-lg flex items-center justify-center\" data-kid=\"145\">\n              <i class=\"ri-heart-pulse-fill text-white text-lg\" data-kid=\"146\"></i>\n            </div>\n            <span class=\"text-lg font-bold tracking-tight\" data-kid=\"147\">MediClick</span>\n          </div>\n          <p class=\"text-gray-400 max-w-xs\" data-kid=\"148\">Software inteligente diseñado por médicos para optimizar el cuidado del paciente.</p>\n        </div>\n        \n        <div data-kid=\"149\">\n          <h4 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-gray-400\" data-kid=\"150\">Información</h4>\n          <ul class=\"space-y-4\" data-kid=\"151\">\n            <li data-kid=\"152\"><a href=\"#\" class=\"text-sm font-semibold text-gray-600 hover:text-black transition-colors\" data-kid=\"153\">Funciones</a></li>\n            <li data-kid=\"154\"><a href=\"#\" class=\"text-sm font-semibold text-gray-600 hover:text-black transition-colors\" data-kid=\"155\">Nosotros</a></li>\n            <li data-kid=\"156\"><a href=\"#\" class=\"text-sm font-semibold text-gray-600 hover:text-black transition-colors\" data-kid=\"157\">Blog</a></li>\n          </ul>\n        </div>\n\n        <div data-kid=\"158\">\n          <h4 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-gray-400\" data-kid=\"159\">Legal</h4>\n          <ul class=\"space-y-4\" data-kid=\"160\">\n            <li data-kid=\"161\"><a href=\"#\" class=\"text-sm font-semibold text-gray-600 hover:text-black transition-colors\" data-kid=\"162\">Términos</a></li>\n            <li data-kid=\"163\"><a href=\"#\" class=\"text-sm font-semibold text-gray-600 hover:text-black transition-colors\" data-kid=\"164\">Privacidad</a></li>\n            <li data-kid=\"165\"><a href=\"#\" class=\"text-sm font-semibold text-gray-600 hover:text-black transition-colors\" data-kid=\"166\">Cookies</a></li>\n          </ul>\n        </div>\n\n        <div data-kid=\"167\">\n          <h4 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-gray-400\" data-kid=\"168\">Contacto</h4>\n          <ul class=\"space-y-4\" data-kid=\"169\">\n            <li data-kid=\"170\"><a href=\"mailto:info@mediclick.health\" class=\"text-sm font-semibold text-gray-600 hover:text-black transition-colors\" data-kid=\"171\">info@mediclick.health</a></li>\n            <li class=\"flex gap-4 pt-2\" data-kid=\"172\">\n              <i class=\"ri-facebook-fill text-xl text-gray-400 hover:text-black transition-colors\" data-kid=\"173\"></i>\n              <i class=\"ri-twitter-x-fill text-xl text-gray-400 hover:text-black transition-colors\" data-kid=\"174\"></i>\n              <i class=\"ri-linkedin-fill text-xl text-gray-400 hover:text-black transition-colors\" data-kid=\"175\"></i>\n            </li>\n          </ul>\n        </div>\n      </div>\n      \n      <div class=\"pt-8 border-t border-black/5 flex justify-between items-center text-xs font-bold text-gray-400\" data-kid=\"176\">\n        <p data-kid=\"177\">© 2026 MediClick, Inc.</p>\n        <div class=\"flex gap-6\" data-kid=\"178\">\n          <span data-kid=\"179\">Status</span>\n          <span data-kid=\"180\">Seguridad</span>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>",
