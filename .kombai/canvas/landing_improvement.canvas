    "var_3ee020478f8e": {
      "type": "variant",
      "label": "MediClick: Structured SaaS (Modern & Clean)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 1348
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    color: #0F172A;\n    background-color: #F8FAFC;\n    margin: 0;\n  }\n\n  .font-serif {\n    font-family: 'Merriweather', serif;\n  }\n\n  .bg-grid {\n    background-size: 40px 40px;\n    background-image: radial-gradient(circle, #E2E8F0 1px, transparent 1px);\n  }\n\n  .glass {\n    background: rgba(255, 255, 255, 0.8);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n  }\n\n  /* Custom scrollbar for carousel */\n  .no-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .no-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n</style>\n\n<div class=\"relative min-h-screen bg-slate-50 selection:bg-blue-100 selection:text-blue-900\" data-kid=\"1\">\n  \n  <div class=\"absolute inset-0 bg-grid opacity-40 pointer-events-none\" data-kid=\"2\"></div>\n\n  \n  <header class=\"sticky top-0 z-50 glass border-b border-slate-200/60\" data-kid=\"3\">\n    <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"4\">\n      <div class=\"flex items-center gap-2\" data-kid=\"5\">\n        <div class=\"w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center shadow-lg shadow-blue-500/30\" data-kid=\"6\">\n          <i class=\"ti ti-heart-pulse text-white text-2xl\" data-kid=\"7\"></i>\n        </div>\n        <span class=\"text-2xl font-extrabold tracking-tight text-slate-900\" data-kid=\"8\">MediClick</span>\n      </div>\n      \n      <nav class=\"hidden md:flex items-center gap-8\" data-kid=\"9\">\n        <a href=\"#features\" class=\"text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors\" data-kid=\"10\">Funciones</a>\n        <a href=\"#specialties\" class=\"text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors\" data-kid=\"11\">Especialidades</a>\n        <a href=\"#testimonials\" class=\"text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors\" data-kid=\"12\">Testimonios</a>\n        <a href=\"#pricing\" class=\"text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors\" data-kid=\"13\">Planes</a>\n      </nav>\n\n      <div class=\"flex items-center gap-4\" data-kid=\"14\">\n        <a href=\"/login\" class=\"text-sm font-bold text-slate-900 hover:text-blue-600 px-4 py-2 transition-colors\" data-kid=\"15\">Ingresar</a>\n        <a href=\"/signup\" class=\"bg-slate-900 text-white text-sm font-bold px-6 py-2.5 rounded-full hover:bg-slate-800 transition-all shadow-xl shadow-slate-900/10\" data-kid=\"16\">Registrarse</a>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"relative\" data-kid=\"17\">\n    \n    <section class=\"relative pt-20 pb-32 overflow-hidden\" data-kid=\"18\">\n      <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"19\">\n        <div class=\"grid lg:grid-cols-2 gap-16 items-center\" data-kid=\"20\">\n          <div class=\"max-w-2xl\" data-kid=\"21\">\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 mb-6\" data-kid=\"22\">\n              <span class=\"relative flex h-2 w-2\" data-kid=\"23\">\n                <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75\" data-kid=\"24\"></span>\n                <span class=\"relative inline-flex rounded-full h-2 w-2 bg-blue-500\" data-kid=\"25\"></span>\n              </span>\n              <span class=\"text-xs font-bold text-blue-700 uppercase tracking-wider\" data-kid=\"26\">Nueva Versión 4.0</span>\n            </div>\n            <h1 class=\"font-serif text-5xl lg:text-7xl font-black text-slate-900 leading-[1.1] mb-8\" data-kid=\"27\">\n              La medicina evoluciona. <span class=\"text-blue-600 italic\" data-kid=\"28\">Su gestión también.</span>\n            </h1>\n            <p class=\"text-lg text-slate-600 leading-relaxed mb-10 max-w-xl\" data-kid=\"29\">\n              MediClick es el sistema operativo clínico diseñado para liberar a los médicos de la carga administrativa. Historias clínicas, agenda inteligente y facturación en una sola interfaz de alta gama.\n            </p>\n            <div class=\"flex flex-col sm:flex-row gap-4\" data-kid=\"30\">\n              <button class=\"px-8 py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-2xl shadow-blue-600/30 flex items-center justify-center gap-2 group\" data-kid=\"31\">\n                Empezar Prueba Gratuita\n                <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"32\"></i>\n              </button>\n              <button class=\"px-8 py-4 bg-white text-slate-900 font-bold rounded-xl border border-slate-200 hover:border-slate-900 transition-all flex items-center justify-center gap-2\" data-kid=\"33\">\n                Ver Video Demo\n                <i class=\"ti ti-player-play-filled text-blue-600\" data-kid=\"34\"></i>\n              </button>\n            </div>\n            \n            <div class=\"mt-12 flex items-center gap-6\" data-kid=\"35\">\n              <div class=\"flex -space-x-3\" data-kid=\"36\">\n                <img src=\"https://i.pravatar.cc/100?u=dr1\" alt=\"Doctor 1\" class=\"w-10 h-10 rounded-full border-2 border-white ring-1 ring-slate-100\" data-kid=\"37\">\n                <img src=\"https://i.pravatar.cc/100?u=dr2\" alt=\"Doctor 2\" class=\"w-10 h-10 rounded-full border-2 border-white ring-1 ring-slate-100\" data-kid=\"38\">\n                <img src=\"https://i.pravatar.cc/100?u=dr3\" alt=\"Doctor 3\" class=\"w-10 h-10 rounded-full border-2 border-white ring-1 ring-slate-100\" data-kid=\"39\">\n              </div>\n              <p class=\"text-sm font-medium text-slate-500\" data-kid=\"40\">\n                <span class=\"text-slate-900 font-bold\" data-kid=\"41\">+2,500</span> médicos especialistas ya confían en nosotros.\n              </p>\n            </div>\n          </div>\n\n          <div class=\"relative\" data-kid=\"42\">\n            <div class=\"absolute -inset-10 bg-blue-500/5 blur-3xl rounded-full\" data-kid=\"43\"></div>\n            <div class=\"relative rounded-3xl overflow-hidden border border-slate-200 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.1)]\" data-kid=\"44\">\n              <img src=\"https://images.unsplash.com/photo-1758691462774-f01ed567f2c4?auto=format&w=800&q=80&fit=crop\" alt=\"Doctor utilizando tablet en clínica moderna\" class=\"w-full aspect-[4/5] object-cover\" loading=\"lazy\" decoding=\"async\" data-kid=\"45\">\n              \n              <div class=\"absolute top-8 -left-8 glass p-4 rounded-2xl border border-white/40 shadow-xl animate-bounce-slow\" data-kid=\"46\">\n                <div class=\"flex items-center gap-3\" data-kid=\"47\">\n                  <div class=\"w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center\" data-kid=\"48\">\n                    <i class=\"ti ti-check text-emerald-600\" data-kid=\"49\"></i>\n                  </div>\n                  <div data-kid=\"50\">\n                    <p class=\"text-[10px] font-bold text-slate-400 uppercase tracking-tighter\" data-kid=\"51\">Cita Confirmada</p>\n                    <p class=\"text-xs font-bold text-slate-900\" data-kid=\"52\">Ana Banana — 14:30</p>\n                  </div>\n                </div>\n              </div>\n              <div class=\"absolute bottom-12 -right-8 glass p-4 rounded-2xl border border-white/40 shadow-xl\" data-kid=\"53\">\n                <div class=\"flex items-center gap-3 mb-2\" data-kid=\"54\">\n                  <div class=\"w-2 h-2 rounded-full bg-blue-600\" data-kid=\"55\"></div>\n                  <p class=\"text-[10px] font-bold text-slate-900 uppercase\" data-kid=\"56\">Productividad</p>\n                </div>\n                <div class=\"flex items-baseline gap-1\" data-kid=\"57\">\n                  <p class=\"text-2xl font-black text-slate-900 tracking-tighter\" data-kid=\"58\">+3.2h</p>\n                  <p class=\"text-[10px] text-slate-500 font-semibold\" data-kid=\"59\">ahorradas/día</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-12 border-y border-slate-200/60 bg-white/50\" data-kid=\"60\">\n      <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"61\">\n        <p class=\"text-center text-xs font-bold text-slate-400 uppercase tracking-widest mb-8\" data-kid=\"62\">Empoderando a las mejores instituciones médicas</p>\n        <div class=\"flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-40 grayscale\" data-kid=\"63\">\n          <div class=\"text-2xl font-black italic\" data-kid=\"64\">CLINICA VITAL</div>\n          <div class=\"text-2xl font-black italic\" data-kid=\"65\">HOSPITAL SAN JOSE</div>\n          <div class=\"text-2xl font-black italic\" data-kid=\"66\">MEDCENTER</div>\n          <div class=\"text-2xl font-black italic\" data-kid=\"67\">HOSPITAL NIÑO</div>\n          <div class=\"text-2xl font-black italic\" data-kid=\"68\">ONCOSALUD</div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"features\" class=\"py-32 relative\" data-kid=\"69\">\n      <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"70\">\n        <div class=\"text-center max-w-3xl mx-auto mb-20\" data-kid=\"71\">\n          <h2 class=\"font-serif text-4xl lg:text-5xl font-black text-slate-900 mb-6\" data-kid=\"72\">Herramientas profesionales para una práctica moderna.</h2>\n          <p class=\"text-slate-600 text-lg\" data-kid=\"73\">Diseñamos cada función pensando en la eficiencia del flujo de trabajo médico y la seguridad del paciente.</p>\n        </div>\n\n        <div class=\"grid md:grid-cols-3 gap-8\" data-kid=\"74\">\n          \n          <div class=\"group bg-white p-10 rounded-[2rem] border border-slate-200/60 shadow-sm hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-500 hover:-translate-y-2\" data-kid=\"75\">\n            <div class=\"w-14 h-14 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-500\" data-kid=\"76\">\n              <i class=\"ti ti-calendar-time text-3xl\" data-kid=\"77\"></i>\n            </div>\n            <h3 class=\"text-xl font-bold text-slate-900 mb-4\" data-kid=\"78\">Agenda Inteligente</h3>\n            <p class=\"text-slate-600 leading-relaxed\" data-kid=\"79\">Gestión multi-sede con detección automática de conflictos, sobre-reservas controladas y portal de auto-agendamiento para pacientes.</p>\n          </div>\n          \n          <div class=\"group bg-white p-10 rounded-[2rem] border border-slate-200/60 shadow-sm hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-500 hover:-translate-y-2\" data-kid=\"80\">\n            <div class=\"w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-500\" data-kid=\"81\">\n              <i class=\"ti ti-clipboard-text text-3xl\" data-kid=\"82\"></i>\n            </div>\n            <h3 class=\"text-xl font-bold text-slate-900 mb-4\" data-kid=\"83\">Historia Clínica Digital</h3>\n            <p class=\"text-slate-600 leading-relaxed\" data-kid=\"84\">Expediente electrónico completo con búsqueda CIE-10 integrada, carga de imágenes diagnósticas y cronología evolutiva del paciente.</p>\n          </div>\n          \n          <div class=\"group bg-white p-10 rounded-[2rem] border border-slate-200/60 shadow-sm hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-500 hover:-translate-y-2\" data-kid=\"85\">\n            <div class=\"w-14 h-14 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-500\" data-kid=\"86\">\n              <i class=\"ti ti-file-certificate text-3xl\" data-kid=\"87\"></i>\n            </div>\n            <h3 class=\"text-xl font-bold text-slate-900 mb-4\" data-kid=\"88\">Recetas Digitales</h3>\n            <p class=\"text-slate-600 leading-relaxed\" data-kid=\"89\">Generación de recetas profesionales en PDF firmadas digitalmente, con envío automático vía email o WhatsApp al paciente.</p>\n          </div>\n          \n          <div class=\"group bg-white p-10 rounded-[2rem] border border-slate-200/60 shadow-sm hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-500 hover:-translate-y-2\" data-kid=\"90\">\n            <div class=\"w-14 h-14 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-amber-600 group-hover:text-white transition-colors duration-500\" data-kid=\"91\">\n              <i class=\"ti ti-chart-pie text-3xl\" data-kid=\"92\"></i>\n            </div>\n            <h3 class=\"text-xl font-bold text-slate-900 mb-4\" data-kid=\"93\">Finanzas y Analítica</h3>\n            <p class=\"text-slate-600 leading-relaxed\" data-kid=\"94\">Control total de ingresos, pagos pendientes y proformas. Dashboard en tiempo real sobre la rentabilidad de su consultorio.</p>\n          </div>\n          \n          <div class=\"group bg-white p-10 rounded-[2rem] border border-slate-200/60 shadow-sm hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-500 hover:-translate-y-2\" data-kid=\"95\">\n            <div class=\"w-14 h-14 bg-rose-50 text-rose-600 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-rose-600 group-hover:text-white transition-colors duration-500\" data-kid=\"96\">\n              <i class=\"ti ti-shield-lock text-3xl\" data-kid=\"97\"></i>\n            </div>\n            <h3 class=\"text-xl font-bold text-slate-900 mb-4\" data-kid=\"98\">Seguridad de Grado Médico</h3>\n            <p class=\"text-slate-600 leading-relaxed\" data-kid=\"99\">Cifrado de punta a punta, cumplimiento con normativas de protección de datos y roles de acceso (RBAC) totalmente personalizables.</p>\n          </div>\n          \n          <div class=\"group bg-white p-10 rounded-[2rem] border border-slate-200/60 shadow-sm hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-500 hover:-translate-y-2\" data-kid=\"100\">\n            <div class=\"w-14 h-14 bg-cyan-50 text-cyan-600 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-cyan-600 group-hover:text-white transition-colors duration-500\" data-kid=\"101\">\n              <i class=\"ti ti-device-mobile text-3xl\" data-kid=\"102\"></i>\n            </div>\n            <h3 class=\"text-xl font-bold text-slate-900 mb-4\" data-kid=\"103\">App Multi-dispositivo</h3>\n            <p class=\"text-slate-600 leading-relaxed\" data-kid=\"104\">Acceda a su consultorio desde su smartphone, tablet o laptop. Diseñado para una experiencia fluida sin importar dónde esté.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"testimonials\" class=\"py-32 bg-slate-900 relative overflow-hidden\" data-kid=\"105\">\n      <div class=\"absolute inset-0 bg-grid opacity-5 invert\" data-kid=\"106\"></div>\n      <div class=\"max-w-7xl mx-auto px-6 relative z-10\" data-kid=\"107\">\n        <div class=\"flex flex-col md:flex-row md:items-end justify-between mb-16\" data-kid=\"108\">\n          <div class=\"max-w-xl\" data-kid=\"109\">\n            <p class=\"text-blue-400 font-bold uppercase tracking-widest text-xs mb-4\" data-kid=\"110\">Experiencia de Usuario</p>\n            <h2 class=\"font-serif text-4xl lg:text-5xl font-black text-white mb-0\" data-kid=\"111\">Lo que dicen los especialistas.</h2>\n          </div>\n          <div class=\"mt-8 md:mt-0 flex gap-4\" data-kid=\"112\">\n            <button class=\"w-12 h-12 rounded-full border border-white/20 text-white flex items-center justify-center hover:bg-white hover:text-slate-900 transition-all\" data-kid=\"113\">\n              <i class=\"ti ti-chevron-left text-xl\" data-kid=\"114\"></i>\n            </button>\n            <button class=\"w-12 h-12 rounded-full border border-white/20 text-white flex items-center justify-center hover:bg-white hover:text-slate-900 transition-all\" data-kid=\"115\">\n              <i class=\"ti ti-chevron-right text-xl\" data-kid=\"116\"></i>\n            </button>\n          </div>\n        </div>\n\n        <div class=\"flex gap-8 overflow-x-auto no-scrollbar pb-12 snap-x\" data-kid=\"117\">\n          \n          <div class=\"min-w-[400px] snap-center bg-white/5 border border-white/10 p-10 rounded-3xl backdrop-blur-sm\" data-kid=\"118\">\n            <div class=\"flex gap-1 mb-8 text-amber-400\" data-kid=\"119\">\n              <i class=\"ti ti-star-filled\" data-kid=\"120\"></i><i class=\"ti ti-star-filled\" data-kid=\"121\"></i><i class=\"ti ti-star-filled\" data-kid=\"122\"></i><i class=\"ti ti-star-filled\" data-kid=\"123\"></i><i class=\"ti ti-star-filled\" data-kid=\"124\"></i>\n            </div>\n            <p class=\"text-xl text-slate-300 leading-relaxed italic mb-10\" data-kid=\"125\">\n              \"MediClick ha transformado mi práctica privada. El flujo de citas es impecable y la generación de recetas me ahorra al menos una hora diaria.\"\n            </p>\n            <div class=\"flex items-center gap-4\" data-kid=\"126\">\n              <img src=\"https://i.pravatar.cc/150?u=doc4\" alt=\"Avatar\" class=\"w-14 h-14 rounded-full border-2 border-white/10\" data-kid=\"127\">\n              <div data-kid=\"128\">\n                <p class=\"text-white font-bold\" data-kid=\"129\">Dr. Enrique Malpartida</p>\n                <p class=\"text-slate-500 text-sm\" data-kid=\"130\">Especialista en Dermatología</p>\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"min-w-[400px] snap-center bg-white/5 border border-white/10 p-10 rounded-3xl backdrop-blur-sm\" data-kid=\"131\">\n            <div class=\"flex gap-1 mb-8 text-amber-400\" data-kid=\"132\">\n              <i class=\"ti ti-star-filled\" data-kid=\"133\"></i><i class=\"ti ti-star-filled\" data-kid=\"134\"></i><i class=\"ti ti-star-filled\" data-kid=\"135\"></i><i class=\"ti ti-star-filled\" data-kid=\"136\"></i><i class=\"ti ti-star-filled\" data-kid=\"137\"></i>\n            </div>\n            <p class=\"text-xl text-slate-300 leading-relaxed italic mb-10\" data-kid=\"138\">\n              \"La capacidad de gestionar múltiples sedes desde una sola cuenta es lo que me convenció. La interfaz es intuitiva y el soporte técnico es excepcional.\"\n            </p>\n            <div class=\"flex items-center gap-4\" data-kid=\"139\">\n              <img src=\"https://i.pravatar.cc/150?u=doc5\" alt=\"Avatar\" class=\"w-14 h-14 rounded-full border-2 border-white/10\" data-kid=\"140\">\n              <div data-kid=\"141\">\n                <p class=\"text-white font-bold\" data-kid=\"142\">Dra. Natalí Leiva</p>\n                <p class=\"text-slate-500 text-sm\" data-kid=\"143\">Pediatría Integral</p>\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"min-w-[400px] snap-center bg-white/5 border border-white/10 p-10 rounded-3xl backdrop-blur-sm\" data-kid=\"144\">\n            <div class=\"flex gap-1 mb-8 text-amber-400\" data-kid=\"145\">\n              <i class=\"ti ti-star-filled\" data-kid=\"146\"></i><i class=\"ti ti-star-filled\" data-kid=\"147\"></i><i class=\"ti ti-star-filled\" data-kid=\"148\"></i><i class=\"ti ti-star-filled\" data-kid=\"149\"></i><i class=\"ti ti-star-filled\" data-kid=\"150\"></i>\n            </div>\n            <p class=\"text-xl text-slate-300 leading-relaxed italic mb-10\" data-kid=\"151\">\n              \"Es la primera vez que encuentro un software médico que realmente entiende las necesidades del especialista. La integración con CIE-10 es brillante.\"\n            </p>\n            <div class=\"flex items-center gap-4\" data-kid=\"152\">\n              <img src=\"https://i.pravatar.cc/150?u=doc6\" alt=\"Avatar\" class=\"w-14 h-14 rounded-full border-2 border-white/10\" data-kid=\"153\">\n              <div data-kid=\"154\">\n                <p class=\"text-white font-bold\" data-kid=\"155\">Dr. Jorge Luis Espinoza</p>\n                <p class=\"text-slate-500 text-sm\" data-kid=\"156\">Ginecología y Obstetricia</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"pricing\" class=\"py-32\" data-kid=\"157\">\n      <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"158\">\n        <div class=\"text-center max-w-2xl mx-auto mb-20\" data-kid=\"159\">\n          <h2 class=\"font-serif text-4xl lg:text-5xl font-black text-slate-900 mb-6\" data-kid=\"160\">Planes que crecen contigo.</h2>\n          <p class=\"text-slate-600 text-lg\" data-kid=\"161\">Sin letras pequeñas. Elija el plan que mejor se adapte al tamaño de su centro médico.</p>\n        </div>\n\n        <div class=\"grid lg:grid-cols-3 gap-8\" data-kid=\"162\">\n          \n          <div class=\"bg-white p-12 rounded-[2.5rem] border border-slate-200/60 flex flex-col transition-transform hover:scale-[1.02]\" data-kid=\"163\">\n            <h3 class=\"text-sm font-bold text-slate-400 uppercase tracking-widest mb-4\" data-kid=\"164\">Starter</h3>\n            <div class=\"flex items-baseline gap-1 mb-8\" data-kid=\"165\">\n              <span class=\"text-5xl font-black text-slate-900\" data-kid=\"166\">$19</span>\n              <span class=\"text-slate-500 font-semibold\" data-kid=\"167\">/mes</span>\n            </div>\n            <p class=\"text-slate-500 text-sm mb-10\" data-kid=\"168\">Para médicos con consulta privada independiente.</p>\n            <ul class=\"space-y-4 mb-12 flex-1\" data-kid=\"169\">\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-600\" data-kid=\"170\">\n                <i class=\"ti ti-circle-check text-blue-600\" data-kid=\"171\"></i> 1 Sede / Consultorio\n              </li>\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-600\" data-kid=\"172\">\n                <i class=\"ti ti-circle-check text-blue-600\" data-kid=\"173\"></i> Hasta 2 Doctores\n              </li>\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-600\" data-kid=\"174\">\n                <i class=\"ti ti-circle-check text-blue-600\" data-kid=\"175\"></i> Agenda Completa\n              </li>\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-600\" data-kid=\"176\">\n                <i class=\"ti ti-circle-check text-blue-600\" data-kid=\"177\"></i> Recetas PDF\n              </li>\n            </ul>\n            <button class=\"w-full py-4 rounded-xl border border-slate-200 text-slate-900 font-bold hover:bg-slate-50 transition-colors\" data-kid=\"178\">Empezar Starter</button>\n          </div>\n          \n          <div class=\"bg-slate-900 p-12 rounded-[2.5rem] border-4 border-blue-600 flex flex-col relative shadow-2xl shadow-blue-500/20 transition-transform hover:scale-[1.05] z-10 lg:-mt-4 lg:mb-4\" data-kid=\"179\">\n            <div class=\"absolute -top-5 left-1/2 -translate-x-1/2 bg-blue-600 text-white px-6 py-2 rounded-full text-xs font-black uppercase tracking-widest\" data-kid=\"180\">Recomendado</div>\n            <h3 class=\"text-sm font-bold text-slate-400 uppercase tracking-widest mb-4\" data-kid=\"181\">Profesional</h3>\n            <div class=\"flex items-baseline gap-1 mb-8\" data-kid=\"182\">\n              <span class=\"text-5xl font-black text-white\" data-kid=\"183\">$49</span>\n              <span class=\"text-slate-400 font-semibold\" data-kid=\"184\">/mes</span>\n            </div>\n            <p class=\"text-slate-400 text-sm mb-10\" data-kid=\"185\">Para clínicas pequeñas y centros en crecimiento.</p>\n            <ul class=\"space-y-4 mb-12 flex-1\" data-kid=\"186\">\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-200\" data-kid=\"187\">\n                <i class=\"ti ti-circle-check-filled text-blue-500\" data-kid=\"188\"></i> Hasta 3 Sedes\n              </li>\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-200\" data-kid=\"189\">\n                <i class=\"ti ti-circle-check-filled text-blue-500\" data-kid=\"190\"></i> Doctores Ilimitados\n              </li>\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-200\" data-kid=\"191\">\n                <i class=\"ti ti-circle-check-filled text-blue-500\" data-kid=\"192\"></i> Dashboard de Analítica\n              </li>\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-200\" data-kid=\"193\">\n                <i class=\"ti ti-circle-check-filled text-blue-500\" data-kid=\"194\"></i> Roles RBAC Avanzados\n              </li>\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-200\" data-kid=\"195\">\n                <i class=\"ti ti-circle-check-filled text-blue-500\" data-kid=\"196\"></i> Firma Digital\n              </li>\n            </ul>\n            <button class=\"w-full py-4 rounded-xl bg-blue-600 text-white font-bold hover:bg-blue-700 transition-colors shadow-xl shadow-blue-600/30\" data-kid=\"197\">Adquirir Profesional</button>\n          </div>\n          \n          <div class=\"bg-white p-12 rounded-[2.5rem] border border-slate-200/60 flex flex-col transition-transform hover:scale-[1.02]\" data-kid=\"198\">\n            <h3 class=\"text-sm font-bold text-slate-400 uppercase tracking-widest mb-4\" data-kid=\"199\">Enterprise</h3>\n            <div class=\"flex items-baseline gap-1 mb-8\" data-kid=\"200\">\n              <span class=\"text-5xl font-black text-slate-900\" data-kid=\"201\">$99</span>\n              <span class=\"text-slate-500 font-semibold\" data-kid=\"202\">/mes</span>\n            </div>\n            <p class=\"text-slate-500 text-sm mb-10\" data-kid=\"203\">Para redes hospitalarias y centros de alta complejidad.</p>\n            <ul class=\"space-y-4 mb-12 flex-1\" data-kid=\"204\">\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-600\" data-kid=\"205\">\n                <i class=\"ti ti-circle-check text-blue-600\" data-kid=\"206\"></i> Sedes Ilimitadas\n              </li>\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-600\" data-kid=\"207\">\n                <i class=\"ti ti-circle-check text-blue-600\" data-kid=\"208\"></i> API REST & GraphQL\n              </li>\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-600\" data-kid=\"209\">\n                <i class=\"ti ti-circle-check text-blue-600\" data-kid=\"210\"></i> Soporte 24/7 VIP\n              </li>\n              <li class=\"flex items-center gap-3 text-sm font-medium text-slate-600\" data-kid=\"211\">\n                <i class=\"ti ti-circle-check text-blue-600\" data-kid=\"212\"></i> SLA Garantizado 99.9%\n              </li>\n            </ul>\n            <button class=\"w-full py-4 rounded-xl border border-slate-200 text-slate-900 font-bold hover:bg-slate-50 transition-colors\" data-kid=\"213\">Contactar Ventas</button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-24 px-6\" data-kid=\"214\">\n      <div class=\"max-w-7xl mx-auto\" data-kid=\"215\">\n        <div class=\"relative bg-blue-600 rounded-[3rem] p-16 md:p-24 overflow-hidden text-center\" data-kid=\"216\">\n          <div class=\"absolute inset-0 bg-grid opacity-10 pointer-events-none\" data-kid=\"217\"></div>\n          <div class=\"relative z-10 max-w-3xl mx-auto\" data-kid=\"218\">\n            <h2 class=\"font-serif text-4xl lg:text-6xl font-black text-white mb-8\" data-kid=\"219\">¿Listo para transformar su atención médica?</h2>\n            <p class=\"text-blue-100 text-xl mb-12\" data-kid=\"220\">Únase a los líderes del sector que ya están modernizando su gestión con MediClick.</p>\n            <div class=\"flex flex-col sm:flex-row gap-6 justify-center\" data-kid=\"221\">\n              <button class=\"px-10 py-5 bg-white text-blue-600 font-black text-lg rounded-2xl hover:bg-slate-50 transition-all shadow-2xl\" data-kid=\"222\">Crear Cuenta Gratis</button>\n              <button class=\"px-10 py-5 bg-blue-700 text-white font-black text-lg rounded-2xl hover:bg-blue-800 transition-all border border-blue-500/50\" data-kid=\"223\">Solicitar Una Demo</button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  \n  <footer class=\"bg-white pt-24 pb-12 border-t border-slate-200\" data-kid=\"224\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"225\">\n      <div class=\"grid md:grid-cols-4 gap-12 mb-20\" data-kid=\"226\">\n        <div class=\"col-span-1 md:col-span-1\" data-kid=\"227\">\n          <div class=\"flex items-center gap-2 mb-8\" data-kid=\"228\">\n            <div class=\"w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center\" data-kid=\"229\">\n              <i class=\"ti ti-heart-pulse text-white text-lg\" data-kid=\"230\"></i>\n            </div>\n            <span class=\"text-xl font-black text-slate-900\" data-kid=\"231\">MediClick</span>\n          </div>\n          <p class=\"text-slate-500 text-sm leading-relaxed mb-8\" data-kid=\"232\">\n            Potenciando la medicina a través de la tecnología. La plataforma integral para médicos y centros de salud modernos.\n          </p>\n          <div class=\"flex gap-4\" data-kid=\"233\">\n            <a href=\"#\" class=\"w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-all\" data-kid=\"234\"><i class=\"ti ti-brand-twitter\" data-kid=\"235\"></i></a>\n            <a href=\"#\" class=\"w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-all\" data-kid=\"236\"><i class=\"ti ti-brand-linkedin\" data-kid=\"237\"></i></a>\n            <a href=\"#\" class=\"w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-all\" data-kid=\"238\"><i class=\"ti ti-brand-facebook\" data-kid=\"239\"></i></a>\n          </div>\n        </div>\n        \n        <div data-kid=\"240\">\n          <h4 class=\"font-bold text-slate-900 mb-6 uppercase text-xs tracking-widest\" data-kid=\"241\">Producto</h4>\n          <ul class=\"space-y-4\" data-kid=\"242\">\n            <li data-kid=\"243\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"244\">Funcionalidades</a></li>\n            <li data-kid=\"245\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"246\">Casos de Uso</a></li>\n            <li data-kid=\"247\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"248\">Precios</a></li>\n            <li data-kid=\"249\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"250\">Seguridad</a></li>\n          </ul>\n        </div>\n        \n        <div data-kid=\"251\">\n          <h4 class=\"font-bold text-slate-900 mb-6 uppercase text-xs tracking-widest\" data-kid=\"252\">Empresa</h4>\n          <ul class=\"space-y-4\" data-kid=\"253\">\n            <li data-kid=\"254\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"255\">Sobre Nosotros</a></li>\n            <li data-kid=\"256\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"257\">Blog Médico</a></li>\n            <li data-kid=\"258\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"259\">Contacto</a></li>\n            <li data-kid=\"260\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"261\">Prensa</a></li>\n          </ul>\n        </div>\n        \n        <div data-kid=\"262\">\n          <h4 class=\"font-bold text-slate-900 mb-6 uppercase text-xs tracking-widest\" data-kid=\"263\">Legal</h4>\n          <ul class=\"space-y-4\" data-kid=\"264\">\n            <li data-kid=\"265\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"266\">Privacidad</a></li>\n            <li data-kid=\"267\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"268\">Términos</a></li>\n            <li data-kid=\"269\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"270\">Cookies</a></li>\n            <li data-kid=\"271\"><a href=\"#\" class=\"text-slate-500 text-sm font-semibold hover:text-blue-600 transition-colors\" data-kid=\"272\">GDPR / HIPAA</a></li>\n          </ul>\n        </div>\n      </div>\n      \n      <div class=\"pt-12 border-t border-slate-100 flex flex-col md:flex-row justify-between items-center gap-6\" data-kid=\"273\">\n        <p class=\"text-slate-400 text-xs font-medium\" data-kid=\"274\">© 2024 MediClick Technologies Inc. Todos los derechos reservados.</p>\n        <div class=\"flex items-center gap-2\" data-kid=\"275\">\n          <div class=\"w-2 h-2 rounded-full bg-emerald-500\" data-kid=\"276\"></div>\n          <span class=\"text-xs font-bold text-slate-500 uppercase\" data-kid=\"277\">Todos los sistemas operativos</span>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>",
