      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --brand-teal: #0D9394;\n    --brand-teal-soft: rgba(13, 147, 148, 0.1);\n  }\n\n  .font-sans {\n    font-family: 'Inter', sans-serif;\n  }\n\n  .step-content {\n    display: none;\n    opacity: 0;\n  }\n\n  .step-content.active {\n    display: block;\n    opacity: 1;\n  }\n\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 4px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: #E5E7EB;\n    border-radius: 10px;\n  }\n</style>\n\n<div class=\"font-sans bg-slate-50 min-h-screen p-6 md:p-12 text-slate-900\" data-kid=\"1\">\n  <div class=\"max-w-5xl mx-auto\" data-kid=\"2\">\n    \n    <header class=\"flex items-center justify-between mb-12\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-[#0D9394] rounded-xl flex items-center justify-center shadow-lg shadow-teal-500/20\" data-kid=\"5\">\n          <i class=\"ti ti-heart-pulse text-white text-2xl\" data-kid=\"6\"></i>\n        </div>\n        <h1 class=\"text-xl font-extrabold tracking-tight\" data-kid=\"7\">MediClick <span class=\"font-normal text-slate-400\" data-kid=\"8\">Booking</span></h1>\n      </div>\n      <button class=\"text-sm font-semibold text-slate-500 hover:text-slate-900 transition-colors flex items-center gap-2\" data-kid=\"9\">\n        <i class=\"ti ti-x text-lg\" data-kid=\"10\"></i> Cancelar\n      </button>\n    </header>\n\n    \n    <div class=\"mb-12\" data-kid=\"11\">\n      <div class=\"flex items-center justify-between relative max-w-2xl mx-auto\" data-kid=\"12\">\n        \n        <div class=\"absolute top-5 left-0 right-0 h-0.5 bg-slate-200 -z-0\" data-kid=\"13\"></div>\n        <div id=\"stepper-line\" class=\"absolute top-5 left-0 h-0.5 bg-[#0D9394] -z-0 transition-all duration-500\" style=\"width: 0%\" data-kid=\"14\"></div>\n\n        \n        <div class=\"relative z-10 flex flex-col items-center gap-2 group\" data-kid=\"15\">\n          <div id=\"step-dot-1\" class=\"w-10 h-10 rounded-full border-2 border-[#0D9394] bg-white flex items-center justify-center font-bold text-sm text-[#0D9394] transition-all duration-300\" data-kid=\"16\">1</div>\n          <span class=\"text-xs font-bold uppercase tracking-wider text-[#0D9394]\" data-kid=\"17\">Servicio</span>\n        </div>\n        \n        <div class=\"relative z-10 flex flex-col items-center gap-2 group\" data-kid=\"18\">\n          <div id=\"step-dot-2\" class=\"w-10 h-10 rounded-full border-2 border-slate-200 bg-white flex items-center justify-center font-bold text-sm text-slate-400 transition-all duration-300\" data-kid=\"19\">2</div>\n          <span class=\"text-xs font-bold uppercase tracking-wider text-slate-400\" data-kid=\"20\">Doctor</span>\n        </div>\n        \n        <div class=\"relative z-10 flex flex-col items-center gap-2 group\" data-kid=\"21\">\n          <div id=\"step-dot-3\" class=\"w-10 h-10 rounded-full border-2 border-slate-200 bg-white flex items-center justify-center font-bold text-sm text-slate-400 transition-all duration-300\" data-kid=\"22\">3</div>\n          <span class=\"text-xs font-bold uppercase tracking-wider text-slate-400\" data-kid=\"23\">Horario</span>\n        </div>\n        \n        <div class=\"relative z-10 flex flex-col items-center gap-2 group\" data-kid=\"24\">\n          <div id=\"step-dot-4\" class=\"w-10 h-10 rounded-full border-2 border-slate-200 bg-white flex items-center justify-center font-bold text-sm text-slate-400 transition-all duration-300\" data-kid=\"25\">4</div>\n          <span class=\"text-xs font-bold uppercase tracking-wider text-slate-400\" data-kid=\"26\">Confirmar</span>\n        </div>\n      </div>\n    </div>\n\n    \n    <div id=\"booking-container\" class=\"relative overflow-hidden bg-white border border-slate-200 rounded-[2rem] shadow-sm min-h-[600px]\" data-kid=\"27\">\n      \n      \n      <div id=\"step-1\" class=\"step-content active p-8 md:p-12 w-full h-full\" data-kid=\"28\">\n        <div class=\"max-w-2xl mx-auto text-center mb-10\" data-kid=\"29\">\n          <h2 class=\"text-3xl font-extrabold tracking-tight mb-4\" data-kid=\"30\">¿Qué especialidad buscas?</h2>\n          <p class=\"text-slate-500 mb-8\" data-kid=\"31\">Selecciona el área médica para encontrar al especialista ideal para ti.</p>\n          \n          <div class=\"relative max-w-md mx-auto mb-10\" data-kid=\"32\">\n            <i class=\"ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xl\" data-kid=\"33\"></i>\n            <input type=\"text\" placeholder=\"Buscar especialidad...\" class=\"w-full pl-12 pr-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-[#0D9394]/20 focus:border-[#0D9394] transition-all\" data-kid=\"34\">\n          </div>\n        </div>\n\n        <div class=\"flex flex-wrap justify-center gap-3\" data-kid=\"35\">\n          <button onclick=\"goToStep(2)\" class=\"px-6 py-3 bg-white border border-slate-200 rounded-full font-semibold hover:border-[#0D9394] hover:text-[#0D9394] hover:bg-teal-50/30 transition-all flex items-center gap-2\" data-kid=\"36\">\n            <i class=\"ti ti-activity text-[#0D9394]\" data-kid=\"37\"></i> Medicina General\n          </button>\n          <button onclick=\"goToStep(2)\" class=\"px-6 py-3 bg-[#0D9394] text-white border border-[#0D9394] rounded-full font-semibold shadow-lg shadow-teal-500/20 flex items-center gap-2\" data-kid=\"38\">\n            <i class=\"ti ti-stomach\" data-kid=\"39\"></i> Gastroenterología\n          </button>\n          <button onclick=\"goToStep(2)\" class=\"px-6 py-3 bg-white border border-slate-200 rounded-full font-semibold hover:border-[#0D9394] hover:text-[#0D9394] transition-all flex items-center gap-2\" data-kid=\"40\">\n            <i class=\"ti ti-heart text-rose-500\" data-kid=\"41\"></i> Cardiología\n          </button>\n          <button onclick=\"goToStep(2)\" class=\"px-6 py-3 bg-white border border-slate-200 rounded-full font-semibold hover:border-[#0D9394] hover:text-[#0D9394] transition-all flex items-center gap-2\" data-kid=\"42\">\n            <i class=\"ti ti-brain text-purple-500\" data-kid=\"43\"></i> Neurología\n          </button>\n          <button onclick=\"goToStep(2)\" class=\"px-6 py-3 bg-white border border-slate-200 rounded-full font-semibold hover:border-[#0D9394] hover:text-[#0D9394] transition-all flex items-center gap-2\" data-kid=\"44\">\n            <i class=\"ti ti-baby-carriage text-blue-500\" data-kid=\"45\"></i> Pediatría\n          </button>\n          <button onclick=\"goToStep(2)\" class=\"px-6 py-3 bg-white border border-slate-200 rounded-full font-semibold hover:border-[#0D9394] hover:text-[#0D9394] transition-all flex items-center gap-2\" data-kid=\"46\">\n            <i class=\"ti ti-eye text-amber-500\" data-kid=\"47\"></i> Oftalmología\n          </button>\n          <button onclick=\"goToStep(2)\" class=\"px-6 py-3 bg-white border border-slate-200 rounded-full font-semibold hover:border-[#0D9394] hover:text-[#0D9394] transition-all flex items-center gap-2\" data-kid=\"48\">\n            <i class=\"ti ti-bone text-emerald-500\" data-kid=\"49\"></i> Traumatología\n          </button>\n        </div>\n      </div>\n\n      \n      <div id=\"step-2\" class=\"step-content p-8 md:p-12 w-full h-full\" data-kid=\"50\">\n        <div class=\"flex items-center gap-4 mb-8\" data-kid=\"51\">\n          <button onclick=\"goToStep(1)\" class=\"w-10 h-10 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center hover:bg-slate-100 transition-colors\" data-kid=\"52\">\n            <i class=\"ti ti-arrow-left\" data-kid=\"53\"></i>\n          </button>\n          <div data-kid=\"54\">\n            <h2 class=\"text-2xl font-extrabold tracking-tight\" data-kid=\"55\">Elige a tu especialista</h2>\n            <p class=\"text-sm text-slate-500\" data-kid=\"56\">Gastroenterología • Clínica San Borja</p>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\" data-kid=\"57\">\n          \n          <div class=\"p-6 border border-slate-200 rounded-3xl hover:border-[#0D9394] hover:shadow-xl hover:shadow-teal-500/5 transition-all group flex flex-col justify-between\" data-kid=\"58\">\n            <div class=\"flex gap-4 mb-6\" data-kid=\"59\">\n              <img src=\"https://i.pravatar.cc/150?u=dr1\" class=\"w-20 h-20 rounded-2xl object-cover border border-slate-100\" data-kid=\"60\">\n              <div class=\"flex-1\" data-kid=\"61\">\n                <div class=\"flex items-center justify-between mb-1\" data-kid=\"62\">\n                  <h3 class=\"font-bold text-lg\" data-kid=\"63\">Dr. Andrés Gutiérrez</h3>\n                  <div class=\"flex items-center gap-1 text-amber-400\" data-kid=\"64\">\n                    <i class=\"ti ti-star-filled text-sm\" data-kid=\"65\"></i>\n                    <span class=\"text-xs font-bold text-slate-900\" data-kid=\"66\">4.9</span>\n                  </div>\n                </div>\n                <p class=\"text-sm text-slate-500 mb-3 leading-relaxed\" data-kid=\"67\">Especialista en endoscopia avanzada con más de 12 años de experiencia.</p>\n                <div class=\"flex flex-wrap gap-2\" data-kid=\"68\">\n                  <span class=\"px-2.5 py-1 bg-teal-50 text-[#0D9394] text-[10px] font-bold uppercase tracking-wider rounded-lg border border-teal-100\" data-kid=\"69\">Próximo disponible: Hoy</span>\n                </div>\n              </div>\n            </div>\n            <button onclick=\"goToStep(3)\" class=\"w-full py-3 border-2 border-[#0D9394] text-[#0D9394] font-bold rounded-2xl hover:bg-[#0D9394] hover:text-white transition-all\" data-kid=\"70\">Seleccionar</button>\n          </div>\n\n          \n          <div class=\"p-6 border border-[#0D9394] bg-teal-50/20 rounded-3xl shadow-xl shadow-teal-500/5 flex flex-col justify-between\" data-kid=\"71\">\n            <div class=\"flex gap-4 mb-6\" data-kid=\"72\">\n              <img src=\"https://i.pravatar.cc/150?u=dr2\" class=\"w-20 h-20 rounded-2xl object-cover border border-[#0D9394]/20\" data-kid=\"73\">\n              <div class=\"flex-1\" data-kid=\"74\">\n                <div class=\"flex items-center justify-between mb-1\" data-kid=\"75\">\n                  <h3 class=\"font-bold text-lg text-[#0D9394]\" data-kid=\"76\">Dra. Sofía Méndez</h3>\n                  <div class=\"flex items-center gap-1 text-amber-400\" data-kid=\"77\">\n                    <i class=\"ti ti-star-filled text-sm\" data-kid=\"78\"></i>\n                    <span class=\"text-xs font-bold text-slate-900\" data-kid=\"79\">5.0</span>\n                  </div>\n                </div>\n                <p class=\"text-sm text-slate-500 mb-3 leading-relaxed\" data-kid=\"80\">Referente nacional en salud digestiva y nutrición clínica personalizada.</p>\n                <div class=\"flex flex-wrap gap-2\" data-kid=\"81\">\n                  <span class=\"px-2.5 py-1 bg-[#0D9394] text-white text-[10px] font-bold uppercase tracking-wider rounded-lg\" data-kid=\"82\">Top Rated</span>\n                </div>\n              </div>\n            </div>\n            <button onclick=\"goToStep(3)\" class=\"w-full py-3 bg-[#0D9394] text-white font-bold rounded-2xl hover:brightness-110 transition-all\" data-kid=\"83\">Seleccionar</button>\n          </div>\n        </div>\n      </div>\n\n      \n      <div id=\"step-3\" class=\"step-content p-8 md:p-12 w-full h-full\" data-kid=\"84\">\n        <div class=\"flex items-center gap-4 mb-8\" data-kid=\"85\">\n          <button onclick=\"goToStep(2)\" class=\"w-10 h-10 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center hover:bg-slate-100 transition-colors\" data-kid=\"86\">\n            <i class=\"ti ti-arrow-left\" data-kid=\"87\"></i>\n          </button>\n          <div data-kid=\"88\">\n            <h2 class=\"text-2xl font-extrabold tracking-tight\" data-kid=\"89\">Selecciona fecha y hora</h2>\n            <p class=\"text-sm text-slate-500\" data-kid=\"90\">Cita con Dra. Sofía Méndez</p>\n          </div>\n        </div>\n\n        <div class=\"flex flex-col md:flex-row gap-8 min-h-[400px]\" data-kid=\"91\">\n          \n          <div class=\"w-full md:w-1/3 flex flex-col gap-3 custom-scrollbar overflow-y-auto max-h-[400px] pr-2\" data-kid=\"92\">\n            <button class=\"p-4 rounded-2xl border-2 border-[#0D9394] bg-teal-50/50 text-left transition-all group\" data-kid=\"93\">\n              <span class=\"block text-xs font-bold uppercase tracking-widest text-[#0D9394] mb-1\" data-kid=\"94\">Hoy</span>\n              <span class=\"block text-lg font-extrabold\" data-kid=\"95\">Lunes, 15 Abr</span>\n            </button>\n            <button class=\"p-4 rounded-2xl border border-slate-100 bg-white text-left hover:border-slate-200 transition-all\" data-kid=\"96\">\n              <span class=\"block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1\" data-kid=\"97\">Mañana</span>\n              <span class=\"block text-lg font-extrabold\" data-kid=\"98\">Martes, 16 Abr</span>\n            </button>\n            <button class=\"p-4 rounded-2xl border border-slate-100 bg-white text-left hover:border-slate-200 transition-all\" data-kid=\"99\">\n              <span class=\"block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1\" data-kid=\"100\">Siguiente</span>\n              <span class=\"block text-lg font-extrabold\" data-kid=\"101\">Miércoles, 17 Abr</span>\n            </button>\n            <button class=\"p-4 rounded-2xl border border-slate-100 bg-white text-left hover:border-slate-200 transition-all\" data-kid=\"102\">\n              <span class=\"block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1\" data-kid=\"103\">Siguiente</span>\n              <span class=\"block text-lg font-extrabold\" data-kid=\"104\">Jueves, 18 Abr</span>\n            </button>\n          </div>\n\n          \n          <div class=\"flex-1\" data-kid=\"105\">\n            <div class=\"bg-slate-50 rounded-[2rem] p-6 h-full border border-slate-100\" data-kid=\"106\">\n              <div class=\"flex items-center gap-2 mb-6 text-[#0D9394]\" data-kid=\"107\">\n                <i class=\"ti ti-clock-hour-4 text-xl\" data-kid=\"108\"></i>\n                <span class=\"font-bold\" data-kid=\"109\">Horarios Disponibles</span>\n              </div>\n              \n              <div class=\"grid grid-cols-3 sm:grid-cols-4 gap-3\" data-kid=\"110\">\n                <button onclick=\"goToStep(4)\" class=\"py-3 px-2 bg-white border border-slate-200 rounded-xl font-bold text-sm hover:border-[#0D9394] hover:text-[#0D9394] transition-all\" data-kid=\"111\">09:00 AM</button>\n                <button onclick=\"goToStep(4)\" class=\"py-3 px-2 bg-white border border-slate-200 rounded-xl font-bold text-sm hover:border-[#0D9394] hover:text-[#0D9394] transition-all\" data-kid=\"112\">09:30 AM</button>\n                <button onclick=\"goToStep(4)\" class=\"py-3 px-2 bg-[#0D9394] text-white rounded-xl font-bold text-sm shadow-md\" data-kid=\"113\">10:00 AM</button>\n                <button onclick=\"goToStep(4)\" class=\"py-3 px-2 bg-white border border-slate-200 rounded-xl font-bold text-sm hover:border-[#0D9394] hover:text-[#0D9394] transition-all\" data-kid=\"114\">10:30 AM</button>\n                <button onclick=\"goToStep(4)\" class=\"py-3 px-2 bg-white border border-slate-200 rounded-xl font-bold text-sm hover:border-[#0D9394] hover:text-[#0D9394] transition-all\" data-kid=\"115\">11:00 AM</button>\n                <button onclick=\"goToStep(4)\" class=\"py-3 px-2 bg-white border border-slate-200 rounded-xl font-bold text-sm hover:border-[#0D9394] hover:text-[#0D9394] transition-all\" data-kid=\"116\">11:30 AM</button>\n                <button onclick=\"goToStep(4)\" class=\"py-3 px-2 bg-white border border-slate-200 rounded-xl font-bold text-sm hover:border-[#0D9394] hover:text-[#0D9394] transition-all\" data-kid=\"117\">02:00 PM</button>\n                <button onclick=\"goToStep(4)\" class=\"py-3 px-2 bg-white border border-slate-200 rounded-xl font-bold text-sm hover:border-[#0D9394] hover:text-[#0D9394] transition-all\" data-kid=\"118\">02:30 PM</button>\n                <button onclick=\"goToStep(4)\" class=\"py-3 px-2 bg-white border border-slate-200 rounded-xl font-bold text-sm hover:border-[#0D9394] hover:text-[#0D9394] transition-all\" data-kid=\"119\">03:00 PM</button>\n              </div>\n\n              <div class=\"mt-8 p-4 bg-teal-50 rounded-2xl border border-teal-100 flex items-center gap-3\" data-kid=\"120\">\n                <i class=\"ti ti-info-circle text-[#0D9394] text-xl\" data-kid=\"121\"></i>\n                <p class=\"text-xs text-[#0D9394] font-medium leading-relaxed\" data-kid=\"122\">\n                  Esta cita es presencial. Recuerda llegar 15 minutos antes de tu horario seleccionado.\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div id=\"step-4\" class=\"step-content p-8 md:p-12 w-full h-full\" data-kid=\"123\">\n        <div class=\"max-w-3xl mx-auto\" data-kid=\"124\">\n          <div class=\"flex items-center gap-4 mb-10\" data-kid=\"125\">\n            <button onclick=\"goToStep(3)\" class=\"w-10 h-10 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center hover:bg-slate-100 transition-colors\" data-kid=\"126\">\n              <i class=\"ti ti-arrow-left\" data-kid=\"127\"></i>\n            </button>\n            <h2 class=\"text-2xl font-extrabold tracking-tight\" data-kid=\"128\">Confirma tus detalles</h2>\n          </div>\n\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-10\" data-kid=\"129\">\n            \n            <div class=\"space-y-6\" data-kid=\"130\">\n              <div class=\"space-y-2\" data-kid=\"131\">\n                <label class=\"text-xs font-bold uppercase tracking-widest text-slate-400\" data-kid=\"132\">Nombre Completo</label>\n                <input type=\"text\" value=\"Rafael García\" class=\"w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-[#0D9394]\" data-kid=\"133\">\n              </div>\n              <div class=\"space-y-2\" data-kid=\"134\">\n                <label class=\"text-xs font-bold uppercase tracking-widest text-slate-400\" data-kid=\"135\">Correo Electrónico</label>\n                <input type=\"email\" value=\"rafael@example.com\" class=\"w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-[#0D9394]\" data-kid=\"136\">\n              </div>\n              <div class=\"space-y-2\" data-kid=\"137\">\n                <label class=\"text-xs font-bold uppercase tracking-widest text-slate-400\" data-kid=\"138\">Motivo de consulta</label>\n                <textarea class=\"w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-[#0D9394] h-24\" placeholder=\"Breve descripción...\" data-kid=\"139\"></textarea>\n              </div>\n            </div>\n\n            \n            <div class=\"p-8 bg-[#0D9394] text-white rounded-[2rem] shadow-2xl shadow-teal-900/20 relative overflow-hidden\" data-kid=\"140\">\n              <div class=\"absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-3xl\" data-kid=\"141\"></div>\n              \n              <h3 class=\"text-lg font-bold mb-6 border-b border-white/20 pb-4\" data-kid=\"142\">Resumen de Cita</h3>\n              \n              <div class=\"space-y-4\" data-kid=\"143\">\n                <div class=\"flex items-center gap-3\" data-kid=\"144\">\n                  <div class=\"w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center\" data-kid=\"145\">\n                    <i class=\"ti ti-user-check text-xl\" data-kid=\"146\"></i>\n                  </div>\n                  <div data-kid=\"147\">\n                    <span class=\"block text-[10px] uppercase font-bold text-white/60\" data-kid=\"148\">Especialista</span>\n                    <span class=\"font-bold\" data-kid=\"149\">Dra. Sofía Méndez</span>\n                  </div>\n                </div>\n\n                <div class=\"flex items-center gap-3\" data-kid=\"150\">\n                  <div class=\"w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center\" data-kid=\"151\">\n                    <i class=\"ti ti-calendar-event text-xl\" data-kid=\"152\"></i>\n                  </div>\n                  <div data-kid=\"153\">\n                    <span class=\"block text-[10px] uppercase font-bold text-white/60\" data-kid=\"154\">Fecha y Hora</span>\n                    <span class=\"font-bold\" data-kid=\"155\">Lunes 15 Abr, 10:00 AM</span>\n                  </div>\n                </div>\n\n                <div class=\"flex items-center gap-3\" data-kid=\"156\">\n                  <div class=\"w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center\" data-kid=\"157\">\n                    <i class=\"ti ti-map-pin text-xl\" data-kid=\"158\"></i>\n                  </div>\n                  <div data-kid=\"159\">\n                    <span class=\"block text-[10px] uppercase font-bold text-white/60\" data-kid=\"160\">Sede</span>\n                    <span class=\"font-bold\" data-kid=\"161\">Clínica San Borja</span>\n                  </div>\n                </div>\n              </div>\n\n              <div class=\"mt-8 pt-6 border-t border-dashed border-white/30 flex items-center justify-between\" data-kid=\"162\">\n                <span class=\"font-bold text-lg\" data-kid=\"163\">Total a pagar</span>\n                <span class=\"text-2xl font-extrabold\" data-kid=\"164\">S/ 120.00</span>\n              </div>\n\n              <button class=\"w-full mt-8 py-4 bg-white text-[#0D9394] font-extrabold rounded-2xl hover:scale-[1.02] transition-transform shadow-xl\" data-kid=\"165\">\n                Confirmar y Reservar\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    \n    <div class=\"mt-8 flex justify-center items-center gap-8 text-slate-400\" data-kid=\"166\">\n      <div class=\"flex items-center gap-2 text-xs font-bold uppercase tracking-widest\" data-kid=\"167\">\n        <i class=\"ti ti-shield-lock text-lg text-emerald-500\" data-kid=\"168\"></i> Pago Seguro\n      </div>\n      <div class=\"flex items-center gap-2 text-xs font-bold uppercase tracking-widest\" data-kid=\"169\">\n        <i class=\"ti ti-headset text-lg text-blue-500\" data-kid=\"170\"></i> Soporte 24/7\n      </div>\n    </div>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"171\"></script>\n<script data-kid=\"172\">\n  let currentStep = 1;\n\n  function goToStep(step) {\n    const prevStep = currentStep;\n    currentStep = step;\n\n    // Update Stepper Dots & Line\n    for (let i = 1; i <= 4; i++) {\n      const dot = document.getElementById(`step-dot-${i}`);\n      const label = dot.nextElementSibling;\n      \n      if (i < step) {\n        dot.innerHTML = '<i class=\"ti ti-check\"></i>';\n        dot.className = \"w-10 h-10 rounded-full border-2 border-[#0D9394] bg-[#0D9394] flex items-center justify-center font-bold text-sm text-white transition-all duration-300 shadow-md shadow-teal-500/10\";\n        label.className = \"text-xs font-bold uppercase tracking-wider text-[#0D9394]\";\n      } else if (i === step) {\n        dot.innerHTML = i;\n        dot.className = \"w-10 h-10 rounded-full border-2 border-[#0D9394] bg-white flex items-center justify-center font-bold text-sm text-[#0D9394] transition-all duration-300 shadow-xl shadow-teal-500/10 scale-110\";\n        label.className = \"text-xs font-bold uppercase tracking-wider text-[#0D9394]\";\n      } else {\n        dot.innerHTML = i;\n        dot.className = \"w-10 h-10 rounded-full border-2 border-slate-200 bg-white flex items-center justify-center font-bold text-sm text-slate-400 transition-all duration-300\";\n        label.className = \"text-xs font-bold uppercase tracking-wider text-slate-400\";\n      }\n    }\n\n    const progress = (step - 1) * (100 / 3);\n    document.getElementById('stepper-line').style.width = progress + '%';\n\n    // Transitions with GSAP\n    const prevEl = document.getElementById(`step-${prevStep}`);\n    const nextEl = document.getElementById(`step-${step}`);\n\n    gsap.to(prevEl, {\n      x: step > prevStep ? -50 : 50,\n      opacity: 0,\n      duration: 0.4,\n      onComplete: () => {\n        prevEl.classList.remove('active');\n        nextEl.classList.add('active');\n        gsap.fromTo(nextEl, \n          { x: step > prevStep ? 50 : -50, opacity: 0 },\n          { x: 0, opacity: 1, duration: 0.5, ease: \"power2.out\" }\n        );\n      }\n    });\n  }\n</script>",
