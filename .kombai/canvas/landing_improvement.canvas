      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-sans {\n    font-family: 'Inter', sans-serif;\n  }\n\n  .step-transition {\n    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .no-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n\n  .dashed-separator {\n    background-image: linear-gradient(to right, #D1D5DB 50%, rgba(255,255,255,0) 0%);\n    background-position: bottom;\n    background-size: 8px 1px;\n    background-repeat: repeat-x;\n  }\n</style>\n\n<div class=\"font-sans text-[#111827] bg-white h-screen flex overflow-hidden\" data-kid=\"1\">\n  \n  \n  <aside class=\"w-[30%] bg-[#F9FAFB] border-r border-[#D1D5DB] p-10 flex flex-col h-full\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2 mb-12\" data-kid=\"3\">\n      <div class=\"w-8 h-8 bg-[#111827] rounded-lg flex items-center justify-center\" data-kid=\"4\">\n        <i class=\"ti ti-heart-pulse text-white text-lg\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"text-lg font-bold tracking-tight\" data-kid=\"6\">MediClick</span>\n    </div>\n\n    <div class=\"flex-1\" data-kid=\"7\">\n      <h2 class=\"text-xs font-extrabold uppercase tracking-[0.2em] text-slate-400 mb-8\" data-kid=\"8\">Tu Reserva</h2>\n      \n      <div class=\"space-y-8\" data-kid=\"9\">\n        \n        <div class=\"opacity-100 transition-opacity\" data-kid=\"10\">\n          <p class=\"text-xs font-bold text-slate-400 uppercase mb-2\" data-kid=\"11\">Especialidad</p>\n          <p class=\"text-xl font-bold\" data-kid=\"12\">Cardiología Clínica</p>\n        </div>\n\n        <div class=\"opacity-100 transition-opacity\" data-kid=\"13\">\n          <p class=\"text-xs font-bold text-slate-400 uppercase mb-2\" data-kid=\"14\">Especialista</p>\n          <div class=\"flex items-center gap-3\" data-kid=\"15\">\n            <img src=\"https://i.pravatar.cc/100?u=dr_v3\" alt=\"Doctor\" class=\"w-8 h-8 rounded-full border border-slate-200\" data-kid=\"16\">\n            <p class=\"text-xl font-bold\" data-kid=\"17\">Dr. Alberto Rossi</p>\n          </div>\n        </div>\n\n        <div class=\"opacity-40\" data-kid=\"18\">\n          <p class=\"text-xs font-bold text-slate-400 uppercase mb-2\" data-kid=\"19\">Fecha y Hora</p>\n          <p class=\"text-xl font-bold\" data-kid=\"20\">Pendiente de selección</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"pt-8 border-t border-[#D1D5DB]\" data-kid=\"21\">\n      <div class=\"flex justify-between items-center mb-2\" data-kid=\"22\">\n        <span class=\"text-slate-500 font-medium\" data-kid=\"23\">Consulta Inicial</span>\n        <span class=\"font-bold\" data-kid=\"24\">$80.00</span>\n      </div>\n      <div class=\"flex justify-between items-center text-lg font-extrabold\" data-kid=\"25\">\n        <span data-kid=\"26\">Total</span>\n        <span data-kid=\"27\">$80.00</span>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"w-[70%] h-full overflow-y-auto p-20 no-scrollbar\" data-kid=\"28\">\n    \n    \n    <div class=\"max-w-3xl mx-auto space-y-12\" data-kid=\"29\">\n      <header class=\"mb-16\" data-kid=\"30\">\n        <span class=\"inline-block px-3 py-1 bg-slate-100 text-[#111827] text-[10px] font-bold uppercase tracking-widest mb-4\" data-kid=\"31\">Paso 1 de 4</span>\n        <h1 class=\"text-6xl font-extrabold tracking-tighter leading-tight\" data-kid=\"32\">¿Qué tipo de atención <br data-kid=\"33\">necesitas?</h1>\n      </header>\n\n      <div class=\"space-y-0 border-t border-[#D1D5DB]\" data-kid=\"34\">\n        <button class=\"w-full text-left py-10 border-b border-[#D1D5DB] flex items-center justify-between group hover:bg-slate-50 px-4 transition-colors cursor-pointer\" data-kid=\"35\">\n          <div class=\"flex items-center gap-8\" data-kid=\"36\">\n            <span class=\"text-slate-300 text-2xl font-bold group-hover:text-[#111827] transition-colors\" data-kid=\"37\">01</span>\n            <span class=\"text-4xl font-extrabold tracking-tighter group-hover:translate-x-2 transition-transform\" data-kid=\"38\">Cardiología Clínica</span>\n          </div>\n          <i class=\"ti ti-arrow-right text-3xl opacity-0 group-hover:opacity-100 -translate-x-4 group-hover:translate-x-0 transition-all\" data-kid=\"39\"></i>\n        </button>\n\n        <button class=\"w-full text-left py-10 border-b border-[#D1D5DB] flex items-center justify-between group hover:bg-slate-50 px-4 transition-colors cursor-pointer\" data-kid=\"40\">\n          <div class=\"flex items-center gap-8\" data-kid=\"41\">\n            <span class=\"text-slate-300 text-2xl font-bold group-hover:text-[#111827] transition-colors\" data-kid=\"42\">02</span>\n            <span class=\"text-4xl font-extrabold tracking-tighter group-hover:translate-x-2 transition-transform\" data-kid=\"43\">Pediatría Avanzada</span>\n          </div>\n          <i class=\"ti ti-arrow-right text-3xl opacity-0 group-hover:opacity-100 -translate-x-4 group-hover:translate-x-0 transition-all\" data-kid=\"44\"></i>\n        </button>\n\n        <button class=\"w-full text-left py-10 border-b border-[#D1D5DB] flex items-center justify-between group hover:bg-slate-50 px-4 transition-colors cursor-pointer\" data-kid=\"45\">\n          <div class=\"flex items-center gap-8\" data-kid=\"46\">\n            <span class=\"text-slate-300 text-2xl font-bold group-hover:text-[#111827] transition-colors\" data-kid=\"47\">03</span>\n            <span class=\"text-4xl font-extrabold tracking-tighter group-hover:translate-x-2 transition-transform\" data-kid=\"48\">Dermatología Estética</span>\n          </div>\n          <i class=\"ti ti-arrow-right text-3xl opacity-0 group-hover:opacity-100 -translate-x-4 group-hover:translate-x-0 transition-all\" data-kid=\"49\"></i>\n        </button>\n      </div>\n\n      <div class=\"pt-12 flex justify-between items-center\" data-kid=\"50\">\n        <button class=\"text-slate-400 font-bold hover:text-[#111827] transition-colors uppercase text-xs tracking-widest\" data-kid=\"51\">Otras especialidades</button>\n        <div class=\"flex gap-2\" data-kid=\"52\">\n          <div class=\"w-2 h-2 bg-[#111827] rounded-full\" data-kid=\"53\"></div>\n          <div class=\"w-2 h-2 bg-slate-200 rounded-full\" data-kid=\"54\"></div>\n          <div class=\"w-2 h-2 bg-slate-200 rounded-full\" data-kid=\"55\"></div>\n          <div class=\"w-2 h-2 bg-slate-200 rounded-full\" data-kid=\"56\"></div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"max-w-3xl mx-auto mt-40 pt-40 border-t border-slate-100 space-y-12 opacity-30 pointer-events-none\" data-kid=\"57\">\n      <h2 class=\"text-5xl font-extrabold tracking-tighter\" data-kid=\"58\">Selecciona tu horario</h2>\n      \n      <div class=\"space-y-4\" data-kid=\"59\">\n        <div class=\"border border-[#D1D5DB] p-6 bg-white flex flex-col\" data-kid=\"60\">\n          <div class=\"flex justify-between items-center\" data-kid=\"61\">\n            <span class=\"text-2xl font-bold uppercase tracking-tighter\" data-kid=\"62\">Lunes, 15 de Julio</span>\n            <i class=\"ti ti-chevron-down text-xl\" data-kid=\"63\"></i>\n          </div>\n          <div class=\"grid grid-cols-4 gap-3 mt-8\" data-kid=\"64\">\n            <div class=\"border border-[#111827] bg-[#111827] text-white p-4 text-center font-bold\" data-kid=\"65\">09:00 AM</div>\n            <div class=\"border border-[#D1D5DB] p-4 text-center font-bold hover:border-[#111827]\" data-kid=\"66\">10:30 AM</div>\n            <div class=\"border border-[#D1D5DB] p-4 text-center font-bold hover:border-[#111827]\" data-kid=\"67\">12:00 PM</div>\n            <div class=\"border border-[#D1D5DB] p-4 text-center font-bold hover:border-[#111827]\" data-kid=\"68\">03:30 PM</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </main>\n\n  \n  <div class=\"fixed bottom-10 right-10 flex gap-4 z-50\" data-kid=\"69\">\n    <button class=\"w-16 h-16 bg-white border border-[#D1D5DB] text-[#111827] flex items-center justify-center hover:bg-slate-50 transition-colors\" data-kid=\"70\">\n      <i class=\"ti ti-arrow-left text-2xl\" data-kid=\"71\"></i>\n    </button>\n    <button class=\"px-10 h-16 bg-[#111827] text-white font-extrabold uppercase tracking-widest flex items-center gap-4 hover:bg-black transition-colors group\" data-kid=\"72\">\n      Siguiente paso\n      <i class=\"ti ti-arrow-right text-xl group-hover:translate-x-1 transition-transform\" data-kid=\"73\"></i>\n    </button>\n  </div>\n</div>",
