    },
    "var_430891a4528e": {
      "type": "variant",
      "label": "Dashboard: Patient Portal (Wellness Feed)",
      "parentId": "var_fae980ef8c8e",
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 2081
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&family=Roboto:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-serif { font-family: 'Merriweather', serif; }\n  .font-sans { font-family: 'Roboto', sans-serif; }\n\n  .polaroid-frame {\n    background: white;\n    padding: 12px 12px 40px 12px;\n    box-shadow: 0 10px 30px rgba(0,0,0,0.1);\n    transform: rotate(3deg);\n  }\n\n  .action-card-gradient {\n    background: linear-gradient(135deg, #F43F5E 0%, #FB7185 100%);\n  }\n\n  .timeline-card::before {\n    content: '';\n    position: absolute;\n    left: -12px;\n    top: 24px;\n    width: 24px;\n    height: 24px;\n    background: #FFFCF8;\n    border-radius: 50%;\n    z-index: 10;\n  }\n\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n  .floating-nav {\n    left: 50%;\n    transform: translateX(-50%);\n    box-shadow: 0 10px 40px rgba(244, 63, 94, 0.2);\n  }\n</style>\n\n<div class=\"min-h-screen bg-[#FFFCF8] font-sans text-[#374151] pb-32\" data-kid=\"1\">\n  \n  <header class=\"max-w-6xl mx-auto px-6 py-8 flex justify-between items-center\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-[#F43F5E] rounded-2xl flex items-center justify-center shadow-lg shadow-rose-500/20\" data-kid=\"4\">\n        <i class=\"ti ti-heart-pulse text-white text-2xl\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"text-xl font-black font-serif tracking-tight text-[#F43F5E]\" data-kid=\"6\">MediClick</span>\n    </div>\n    <div class=\"flex items-center gap-4\" data-kid=\"7\">\n      <button class=\"w-12 h-12 rounded-full bg-white flex items-center justify-center border border-rose-100 shadow-sm relative\" data-kid=\"8\">\n        <i class=\"ti ti-bell text-xl\" data-kid=\"9\"></i>\n        <span class=\"absolute top-3 right-3 w-2.5 h-2.5 bg-[#F43F5E] border-2 border-white rounded-full\" data-kid=\"10\"></span>\n      </button>\n      <div class=\"w-12 h-12 rounded-full overflow-hidden border-2 border-white shadow-md\" data-kid=\"11\">\n        <img src=\"https://i.pravatar.cc/100?u=patient1\" alt=\"Avatar\" class=\"w-full h-full object-cover\" data-kid=\"12\">\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"max-w-6xl mx-auto px-6 pt-12 pb-16 relative overflow-hidden\" data-kid=\"13\">\n    <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-12\" data-kid=\"14\">\n      <div class=\"max-w-xl\" data-kid=\"15\">\n        <h1 class=\"font-serif text-5xl md:text-6xl font-black leading-tight text-[#1F2937] mb-6\" data-kid=\"16\">\n          Hola, Ana 👋<br data-kid=\"17\">¿cómo te sientes hoy?\n        </h1>\n        <p class=\"text-lg text-rose-900/60 font-medium max-w-md\" data-kid=\"18\">\n          Tu salud es lo más importante. Aquí tienes el resumen de tus cuidados y recordatorios para hoy.\n        </p>\n      </div>\n      \n      <div class=\"relative\" data-kid=\"19\">\n        <div class=\"polaroid-frame w-64 md:w-72 transition-transform hover:scale-105 duration-500 cursor-pointer\" data-kid=\"20\">\n          <img src=\"https://images.pexels.com/photos/7195121/pexels-photo-7195121.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" alt=\"Wellness Lifestyle\" class=\"w-full aspect-square object-cover rounded-sm grayscale-[20%] hover:grayscale-0 transition-all\" loading=\"lazy\" decoding=\"async\" data-kid=\"21\">\n          <div class=\"mt-4 text-center\" data-kid=\"22\">\n            <span class=\"font-serif italic text-gray-400 text-sm\" data-kid=\"23\">Disfruta el momento</span>\n          </div>\n        </div>\n        \n        <div class=\"absolute -top-10 -right-10 w-40 h-40 bg-rose-100/50 rounded-full blur-3xl -z-10\" data-kid=\"24\"></div>\n        <div class=\"absolute -bottom-10 -left-10 w-32 h-32 bg-orange-100/50 rounded-full blur-2xl -z-10\" data-kid=\"25\"></div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"mb-20\" data-kid=\"26\">\n    <div class=\"max-w-6xl mx-auto px-6 mb-8 flex items-center justify-between\" data-kid=\"27\">\n      <h2 class=\"font-serif text-2xl font-bold text-[#1F2937]\" data-kid=\"28\">Próximas acciones</h2>\n      <button class=\"text-rose-500 font-bold text-sm hover:underline\" data-kid=\"29\">Ver todo</button>\n    </div>\n    <div class=\"flex gap-6 overflow-x-auto px-6 md:px-[calc((100vw-1152px)/2)] no-scrollbar py-4\" data-kid=\"30\">\n      \n      \n      <div class=\"min-w-[320px] md:min-w-[400px] action-card-gradient p-8 rounded-[2.5rem] text-white shadow-xl flex flex-col justify-between h-80 relative overflow-hidden\" data-kid=\"31\">\n        <div class=\"absolute -right-12 -top-12 w-48 h-48 bg-white/10 rounded-full blur-2xl\" data-kid=\"32\"></div>\n        <div data-kid=\"33\">\n          <div class=\"flex items-center gap-3 mb-6\" data-kid=\"34\">\n            <div class=\"w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-md\" data-kid=\"35\">\n              <i class=\"ti ti-calendar text-xl\" data-kid=\"36\"></i>\n            </div>\n            <span class=\"text-sm font-bold uppercase tracking-widest text-rose-100\" data-kid=\"37\">Próxima Cita</span>\n          </div>\n          <h3 class=\"font-serif text-3xl font-bold mb-2 leading-tight\" data-kid=\"38\">Cardiología Control</h3>\n          <p class=\"text-rose-100 font-medium\" data-kid=\"39\">Dr. Andrés Gutiérrez • Clínica Salud</p>\n        </div>\n        <div class=\"flex items-end justify-between\" data-kid=\"40\">\n          <div data-kid=\"41\">\n            <p class=\"text-sm text-rose-100 opacity-80 mb-1\" data-kid=\"42\">Lunes 15 de Agosto</p>\n            <p class=\"text-xl font-black\" data-kid=\"43\">09:00 AM</p>\n          </div>\n          <button class=\"bg-white text-[#F43F5E] px-6 py-3 rounded-2xl font-bold shadow-lg hover:bg-rose-50 transition-colors\" data-kid=\"44\">\n            Indicaciones\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"min-w-[320px] md:min-w-[400px] bg-white p-8 rounded-[2.5rem] border border-rose-100 shadow-xl flex flex-col h-80 relative overflow-hidden\" data-kid=\"45\">\n        <img src=\"https://images.pexels.com/photos/9742922/pexels-photo-9742922.jpeg?auto=compress&cs=tinysrgb&w=400&q=80\" alt=\"Pattern\" class=\"absolute inset-0 w-full h-full object-cover opacity-[0.03] pointer-events-none\" data-kid=\"46\">\n        <div class=\"flex items-center gap-3 mb-6 relative z-10\" data-kid=\"47\">\n          <div class=\"w-10 h-10 bg-orange-100 text-orange-500 rounded-xl flex items-center justify-center\" data-kid=\"48\">\n            <i class=\"ti ti-pill text-xl\" data-kid=\"49\"></i>\n          </div>\n          <span class=\"text-sm font-bold uppercase tracking-widest text-gray-400\" data-kid=\"50\">Toma de Medicamentos</span>\n        </div>\n        <div class=\"space-y-4 relative z-10 flex-1\" data-kid=\"51\">\n          <div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"52\">\n            <div class=\"w-6 h-6 border-2 border-rose-200 rounded-lg flex items-center justify-center group-hover:border-rose-400 transition-colors\" data-kid=\"53\">\n              <i class=\"ti ti-check text-white text-xs\" data-kid=\"54\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"55\">\n              <p class=\"font-bold text-gray-700\" data-kid=\"56\">Omeprazol 20mg</p>\n              <p class=\"text-xs text-gray-400\" data-kid=\"57\">Antes del desayuno</p>\n            </div>\n            <span class=\"text-xs font-bold text-gray-400\" data-kid=\"58\">08:00 AM</span>\n          </div>\n          <div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"59\">\n            <div class=\"w-6 h-6 bg-rose-500 rounded-lg flex items-center justify-center shadow-md shadow-rose-200\" data-kid=\"60\">\n              <i class=\"ti ti-check text-white text-sm\" data-kid=\"61\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"62\">\n              <p class=\"font-bold text-gray-400 line-through\" data-kid=\"63\">Multivitamínico</p>\n              <p class=\"text-xs text-gray-300\" data-kid=\"64\">Con el desayuno</p>\n            </div>\n            <i class=\"ti ti-circle-check-filled text-rose-500 text-xl\" data-kid=\"65\"></i>\n          </div>\n          <div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"66\">\n            <div class=\"w-6 h-6 border-2 border-rose-200 rounded-lg flex items-center justify-center\" data-kid=\"67\"></div>\n            <div class=\"flex-1\" data-kid=\"68\">\n              <p class=\"font-bold text-gray-700\" data-kid=\"69\">Paracetamol 500mg</p>\n              <p class=\"text-xs text-gray-400\" data-kid=\"70\">Cada 8 horas</p>\n            </div>\n            <span class=\"text-xs font-bold text-gray-400\" data-kid=\"71\">04:00 PM</span>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  \n  <section class=\"max-w-3xl mx-auto px-6 pb-20 relative\" data-kid=\"72\">\n    <h2 class=\"font-serif text-2xl font-bold text-[#1F2937] mb-12\" data-kid=\"73\">Tu historial reciente</h2>\n    \n    \n    <div class=\"absolute left-6 md:left-1/2 top-24 bottom-20 w-0.5 border-l-2 border-dashed border-rose-100 -translate-x-1/2 hidden md:block\" data-kid=\"74\"></div>\n\n    <div class=\"space-y-12\" data-kid=\"75\">\n      \n      <div class=\"relative flex flex-col md:flex-row gap-8 items-start\" data-kid=\"76\">\n        <div class=\"hidden md:block w-1/2\" data-kid=\"77\"></div>\n        <div class=\"absolute left-0 md:left-1/2 w-4 h-4 bg-rose-500 rounded-full border-4 border-white shadow-sm -translate-x-1/2 top-6 z-20\" data-kid=\"78\"></div>\n        <div class=\"md:w-1/2 timeline-card bg-white p-6 rounded-3xl border border-rose-50 shadow-lg shadow-rose-100/20 relative ml-8 md:ml-0\" data-kid=\"79\">\n          <div class=\"flex justify-between items-start mb-4\" data-kid=\"80\">\n            <div data-kid=\"81\">\n              <span class=\"text-[10px] font-black uppercase tracking-widest text-rose-400 mb-1 block\" data-kid=\"82\">Resultados Listos</span>\n              <h4 class=\"font-bold text-lg text-gray-800\" data-kid=\"83\">Análisis de Sangre</h4>\n            </div>\n            <div class=\"text-right\" data-kid=\"84\">\n              <p class=\"text-xs font-bold text-gray-400\" data-kid=\"85\">12 JUN</p>\n            </div>\n          </div>\n          <p class=\"text-sm text-gray-500 mb-6 leading-relaxed\" data-kid=\"86\">Tus niveles de glucosa se encuentran dentro del rango normal. Mantén la dieta actual.</p>\n          <button class=\"flex items-center gap-2 text-[#F43F5E] font-bold text-sm bg-rose-50 px-4 py-2 rounded-xl hover:bg-rose-100 transition-colors\" data-kid=\"87\">\n            <i class=\"ti ti-download text-lg\" data-kid=\"88\"></i>\n            Descargar PDF\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"relative flex flex-col md:flex-row-reverse gap-8 items-start\" data-kid=\"89\">\n        <div class=\"hidden md:block w-1/2\" data-kid=\"90\"></div>\n        <div class=\"absolute left-0 md:left-1/2 w-4 h-4 bg-rose-300 rounded-full border-4 border-white shadow-sm -translate-x-1/2 top-6 z-20\" data-kid=\"91\"></div>\n        <div class=\"md:w-1/2 timeline-card bg-white p-6 rounded-3xl border border-rose-50 shadow-lg shadow-rose-100/20 relative ml-8 md:ml-0\" data-kid=\"92\">\n          <div class=\"flex justify-between items-start mb-4\" data-kid=\"93\">\n            <div data-kid=\"94\">\n              <span class=\"text-[10px] font-black uppercase tracking-widest text-gray-300 mb-1 block\" data-kid=\"95\">Consulta Finalizada</span>\n              <h4 class=\"font-bold text-lg text-gray-800\" data-kid=\"96\">Dermatología</h4>\n            </div>\n            <div class=\"text-right\" data-kid=\"97\">\n              <p class=\"text-xs font-bold text-gray-400\" data-kid=\"98\">05 JUN</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-3 mb-4\" data-kid=\"99\">\n            <img src=\"https://i.pravatar.cc/100?u=dr4\" alt=\"Doctor\" class=\"w-8 h-8 rounded-full\" data-kid=\"100\">\n            <p class=\"text-sm font-medium text-gray-500\" data-kid=\"101\">Dra. Natalí Leiva</p>\n          </div>\n          <p class=\"text-sm text-gray-400 italic\" data-kid=\"102\">\"Seguimiento de rutina por dermatitis leve. Tratamiento indicado por 15 días.\"</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <nav class=\"fixed bottom-8 floating-nav bg-white/80 backdrop-blur-2xl px-6 py-4 rounded-[2.5rem] border border-rose-100/50 flex items-center gap-2 z-50\" data-kid=\"103\">\n    <a href=\"#\" class=\"flex flex-col items-center justify-center w-16 h-12 bg-rose-500 text-white rounded-[1.5rem] shadow-lg shadow-rose-500/30\" data-kid=\"104\">\n      <i class=\"ti ti-home text-xl\" data-kid=\"105\"></i>\n    </a>\n    <a href=\"#\" class=\"flex flex-col items-center justify-center w-16 h-12 text-gray-400 hover:text-rose-500 transition-colors\" data-kid=\"106\">\n      <i class=\"ti ti-calendar text-xl\" data-kid=\"107\"></i>\n    </a>\n    <div class=\"w-12 h-12 flex items-center justify-center\" data-kid=\"108\">\n      <div class=\"w-10 h-10 bg-rose-100 text-rose-500 rounded-full flex items-center justify-center hover:scale-110 transition-transform cursor-pointer\" data-kid=\"109\">\n        <i class=\"ti ti-plus text-xl font-bold\" data-kid=\"110\"></i>\n      </div>\n    </div>\n    <a href=\"#\" class=\"flex flex-col items-center justify-center w-16 h-12 text-gray-400 hover:text-rose-500 transition-colors\" data-kid=\"111\">\n      <i class=\"ti ti-history text-xl\" data-kid=\"112\"></i>\n    </a>\n    <a href=\"#\" class=\"flex flex-col items-center justify-center w-16 h-12 text-gray-400 hover:text-rose-500 transition-colors\" data-kid=\"113\">\n      <i class=\"ti ti-user text-xl\" data-kid=\"114\"></i>\n    </a>\n  </nav>\n</div>",
